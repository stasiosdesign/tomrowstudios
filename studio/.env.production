# Settings for the hosted Studio (sanity build / npm run deploy). Public: every
# SANITY_STUDIO_ value is compiled into the Studio, so never put a secret here.

# The site the Visual editor shows: staging's stable URL, never production.
# Change it when staging's address changes (a renamed Vercel project, a custom
# staging domain), add the new origin to Sanity's CORS origins, then deploy
# the Studio: npm run studio:deploy.
SANITY_STUDIO_PREVIEW_ORIGIN=https://tomrowstudios-git-staging-stasiosdesign.vercel.app

# The live site, for the publishing bar: its "Open on the live site" links
# and the build stamp it watches (/build.json) to say when a live publish has
# reached the site. Change it when the production domain changes.
SANITY_STUDIO_PRODUCTION_ORIGIN=https://tomrowstudios.vercel.app
