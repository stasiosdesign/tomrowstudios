# Settings for `npm run studio` (sanity dev). Public: every SANITY_STUDIO_
# value is compiled into the Studio, so never put a secret here. To override
# one on your machine only, use .env.development.local (git-ignored).

# The site the Visual editor shows: your own dev server (npm run dev).
SANITY_STUDIO_PREVIEW_ORIGIN=http://localhost:8766
