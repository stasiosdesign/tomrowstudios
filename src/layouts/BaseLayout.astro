---
/* Site-wide page shell.

   Everything outside <main> survives a Barba navigation — the floating
   navigation, the grid overlay, the lightbox target and the
   scripts — so it lives here once. Each page fills the Barba container;
   the page transition moves the containers themselves (transitions.js).

   The scripts are the site's original files, served from public/js as
   classic scripts (is:inline). They share one global scope by design:
   transitions.js calls the other files' init functions by name on every
   navigation, so they must not be bundled into modules. */
import '../styles/style.css';
import FloatingNav from '../components/FloatingNav.astro';
import SiteHead from '../components/SiteHead.astro';
import ScrollBar from '../components/ScrollBar.astro';
import ReelLightbox from '../components/ReelLightbox.astro';
import { REEL_SRC } from '../components/reel';
import DraftModeLabel from '../components/DraftModeLabel.astro';
import { DESIGN_NOTES } from '../components/design-notes';

interface Props {
  title: string;
  /** Barba namespace for the page (data-barba-namespace). */
  namespace: string;
  /** Label shown on the transition overlay while heading to this page. */
  pageName: string;
  /** Optional extra class on the <main> container. */
  mainClass?: string;
  /** The page's Sanity document type (data-page-doc), for the Visual editor's live drafts (src/sanity/live-preview.ts). */
  pageDoc?: string;
  /** The document's _type when it is not its ID (a collection item, such as a shop item): data-page-type. */
  pageType?: string;
  /** The name the floating navigation shows for the page, when not pageName (data-nav-title). */
  navTitle?: string;
  /** The page the floating menu marks as current, when not this one: a shop item belongs to /shop (data-nav-section). */
  navSection?: string;
  /** The marquee over the floating navigation's bar on this page (data-nav-promo, FloatingNav.astro): the book's, or Contact Tom's. A part of the page can ask for another, or none, with its own data-nav-promo. */
  navPromo?: 'book' | 'contact';
  /** The page's scrollbar in sight from the start and throughout, rather than only while it scrolls (scrollbar.js). */
  pinScrollbar?: boolean;
}

const { title, namespace, pageName, mainClass, pageDoc, pageType, navTitle, navSection, navPromo, pinScrollbar } = Astro.props;

// Production is the one canonical site: every build, staging included, names
// production's address for the page (Astro.site, from SITE_URL), in its clean
// form, /page rather than the page.html file the static build writes.
const path = Astro.url.pathname.replace(/\.html$/, '').replace(/\/index$/, '/');
const canonical = Astro.site && new URL(path, Astro.site).href;
// Anything but production asks search engines to stay away (so does every
// response header there: src/middleware.ts, vercel.ts)
const noindex = __DEPLOYMENT__ !== 'production';
// The design review mode (Shift + G) is a development aid:
// never on production
const showDesignReview = __DEPLOYMENT__ !== 'production';
// The notes travel in the page as JSON, every page's at once (a Barba
// navigation keeps this layer), "<" escaped so none can close the script
const designNotes = showDesignReview ? JSON.stringify(DESIGN_NOTES).replace(/</g, '\\u003c') : '';
// The reel's player goes where its card does: on production, once there is a reel (reel.ts)
const showReel = Boolean(REEL_SRC) || __DEPLOYMENT__ !== 'production';
---
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{title}</title>
{noindex && <meta name="robots" content="noindex, nofollow">}
{canonical && <link rel="canonical" href={canonical}>}
<meta property="og:site_name" content="Tomrowstudios">
<meta property="og:type" content="website">
<meta property="og:title" content={title}>
{canonical && <meta property="og:url" content={canonical}>}
<!-- The first load is held back until the fonts, the scripts and the photos
     marked data-reveal-wait are ready, then faded in (revealPage in
     transitions.js), so it never paints in a fallback face or in the state
     the scripts are about to change. Only with scripts on: without them the
     class is never set. The timeout shows the page anyway if a script fails
     to arrive. -->
<script is:inline>
  document.documentElement.classList.add('is--loading');
  setTimeout(() => document.documentElement.classList.remove('is--loading'), 4000);
  // Every page opens at its top (resetPage in transitions.js), the home
  // page under its opening: the browser is told here, before it has laid
  // anything out, not to put a reloaded page back where it was, which it
  // would otherwise do before the scripts at the foot of the page run
  if ('scrollRestoration' in history) history.scrollRestoration = 'manual';
</script>
<!-- Open the connections to the font and script hosts while the page is
     still being read. Typekit serves its stylesheet plainly and its fonts
     with CORS, two separate connections. Lenis's few rules are in
     style.css, and Swiper's stylesheet comes with Swiper, on the pages that
     use it (swiper.js), so the fonts are the only stylesheet from elsewhere
     that holds up the first paint. -->
<link rel="preconnect" href="https://use.typekit.net">
<link rel="preconnect" href="https://use.typekit.net" crossorigin>
<link rel="preconnect" href="https://cdn.jsdelivr.net">
<link rel="stylesheet" href="https://use.typekit.net/nqu1vih.css">
</head>
<body data-barba="wrapper">

<!-- Design review mode (Shift + G), a review aid for development and
     staging only (a production build leaves it out): the site faded behind
     a translucent white and the design notes over it, each beside the part
     of the page it is about (design-notes.ts, grid-overlay.js, "Design
     notes" in style.css). Desktop only. Outside the Barba container so it
     survives a navigation. -->
{showDesignReview && <div class="design-notes" data-design-notes aria-hidden="true"></div>}
{showDesignReview && <script type="application/json" id="design-notes-data" set:html={designNotes}></script>}

<!-- The cursor's label: what a click does, beside the arrow, over an
     element marked data-cursor-label (cursor.js, "Cursor label" in
     style.css); the words twice, for the marquee. Outside the Barba
     container so it survives a navigation. -->
<div class="cursor-label" data-cursor-label-el aria-hidden="true">
  <span class="cursor-label__box"><span class="cursor-label__window"><span class="cursor-label__track"><span class="cursor-label__text"></span><span class="cursor-label__text"></span></span></span></span>
</div>

<!-- The header's fixed parts: the studio's mark, its name and Contact,
     held at the top of the screen on every page (SiteHead.astro). Outside
     the Barba container, so page changes and the page's transforms leave
     them in place. -->
<SiteHead />

<!-- Click-to-zoom target (outside the Barba container so it persists) -->
<div data-click-zoom-lightbox class="click-zoom__lightbox"></div>

<main data-barba="container" data-barba-namespace={namespace} data-page-name={pageName} data-page-doc={pageDoc} data-page-type={pageType} data-nav-title={navTitle} data-nav-section={navSection} data-nav-promo={navPromo} data-scrollbar-pinned={pinScrollbar ? '' : undefined} class={mainClass}>
<slot />
</main>

<!-- Scrolled-state navigation: the floating bar at the foot of the screen
     and its menu. Outside the Barba container so it survives a navigation;
     floatingnav.js binds it once and re-ties it to each page. -->
<FloatingNav />
<!-- The page's scrollbar, at the right edge; outside the container so it
     lasts across pages (scrollbar.js) -->
<ScrollBar />
<!-- The reel's player, grown out of the Play Reel card in the menu (reel.js) -->
{showReel && <ReelLightbox />}


<script is:inline src="https://cdn.jsdelivr.net/npm/@barba/core@2.10.3/dist/barba.umd.min.js"></script>
<script is:inline src="https://cdn.jsdelivr.net/npm/lenis@1.3.17/dist/lenis.min.js"></script>
<script is:inline src="https://cdn.jsdelivr.net/npm/gsap@3.15/dist/gsap.min.js"></script>
<script is:inline src="https://cdn.jsdelivr.net/npm/gsap@3.15/dist/CustomEase.min.js"></script>
<script is:inline src="https://cdn.jsdelivr.net/npm/gsap@3.15/dist/ScrollTrigger.min.js"></script>
<script is:inline src="https://cdn.jsdelivr.net/npm/gsap@3.15/dist/SplitText.min.js"></script>
<!-- Shared first: the page lifecycle and the on-demand loader -->
<script is:inline src="/js/lifecycle.js"></script>
<script is:inline src="/js/social-copy.js"></script>
<script is:inline src="/js/floatingnav.js"></script>
<script is:inline src="/js/enquiry.js"></script>
<script is:inline src="/js/sidepanel.js"></script>
<script is:inline src="/js/casepanel.js"></script>
<script is:inline src="/js/swiper.js"></script>
<script is:inline src="/js/footer.js"></script>
<script is:inline src="/js/split-hover.js"></script>
<script is:inline src="/js/button.js"></script>
<script is:inline src="/js/marquee.js"></script>
<script is:inline src="/js/odometer.js"></script>
<script is:inline src="/js/steptimeline.js"></script>
<script is:inline src="/js/hotspot.js"></script>
<script is:inline src="/js/centeredslider.js"></script>
<script is:inline src="/js/partners.js"></script>
<script is:inline src="/js/formvalidation.js"></script>
<script is:inline src="/js/archslider.js"></script>
<script is:inline src="/js/scrollnext.js"></script>
<script is:inline src="/js/scrollbar.js"></script>
<script is:inline src="/js/transitions.js"></script>
<script is:inline src="/js/lightbox.js"></script>
<script is:inline src="/js/accordion.js"></script>
<script is:inline src="/js/image-reveal.js"></script>
<script is:inline src="/js/text-highlight.js"></script>
<script is:inline src="/js/scroll-list.js"></script>
<script is:inline src="/js/hero-tint.js"></script>
<script is:inline src="/js/home-list.js"></script>
<script is:inline src="/js/influence.js"></script>
<script is:inline src="/js/logo-carousel.js"></script>
<script is:inline src="/js/loader.js"></script>
<script is:inline src="/js/cursor.js"></script>
<!-- The reel's player (bunny-lightbox.js) is fetched by reel.js on first need -->
<script is:inline src="/js/reel.js"></script>
<!-- Temporary development grid overlay (development and staging only) -->
{showDesignReview && <script is:inline src="/js/grid-overlay.js"></script>}
<!-- Staging and development only: inside the Studio's Visual editor (the page
     in a frame), load the click-to-edit layer and live drafts. The deployment
     is fixed at build time, so a production build leaves all of it out. -->
<script>
  if (__DEPLOYMENT__ !== 'production' && window.self !== window.top) import('../sanity/live-preview');
</script>
{Astro.locals.draftMode && <DraftModeLabel />}

</body>
</html>
