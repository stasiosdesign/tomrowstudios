---
import BaseLayout from '../layouts/BaseLayout.astro';
import SiteNav from '../components/SiteNav.astro';
import SiteFooter from '../components/SiteFooter.astro';
import ContactPanel from '../components/ContactPanel.astro';
import GetInTouch from '../components/GetInTouch.astro';
import Button from '../components/Button.astro';
import { urlFor } from '../sanity/image';
import { CLIENT_LOGOS_QUERY, HOME_PAGE_QUERY } from '../sanity/queries';

// Every section's words and photos, from the Home page document in Sanity,
// and the logo wall's clients in the order set in the Studio. The navigation,
// the footer and where each button leads stay here. Each section below the
// hero carries data-home-section, its field name in the document: opened in
// the Studio's Presentation tool, src/sanity/live-preview.ts finds the
// sections by it, marks their parts editable and swaps in drafts as they are
// typed.
const { sanity } = Astro.locals;
const [home, clients] = await Promise.all([sanity.fetch(HOME_PAGE_QUERY), sanity.fetch(CLIENT_LOGOS_QUERY)]);
if (!home) throw new Error('The Home page document is missing in Sanity');
const { hero, logoWall, practice, slider, recognition, influence, partners, projects, courses } = home;
if (!hero?.slides?.length || !logoWall || !practice || !slider?.images?.length || !recognition?.cards?.length || !influence || !partners || !projects || !courses) {
  throw new Error('A home page section is missing in Sanity (Home page document)');
}

// The four photo bands, each with the page its button leads to
const galleries = [
  { name: 'influence', gallery: influence, href: '/influence' },
  { name: 'partners', gallery: partners, href: '/partner' },
  { name: 'projects', gallery: projects, href: '/architecture' },
  { name: 'courses', gallery: courses, href: '/shop' },
];
---
<BaseLayout title="Tomrow Studios" namespace="index" pageName="Home">
<!-- Home hero, in the reveal-parallax wrapper: the section after it slides
     up over it (footer.js) -->
<div data-hero-parallax class="home-hero-wrap">
<section data-hero-parallax-inner class="home-hero">
  <!-- The hero's backgrounds, one per line of the dial. hero-dial.js
       crossfades them as the dial moves — the layered-slider treatment, on
       the dial's own index. Each is its slide's background photo in the
       Studio (Home page → Dial slides). -->
  <div class="hero-slides" data-hero-slides aria-hidden="true">
    {hero.slides.map((slide) => (
    <div data-hero-slide-bg class="hero-slides__item">{slide.background && <img src={urlFor(slide.background).width(2500).url()} class="hero-slides__img" alt="">}</div>
    ))}
    <!-- A flat darkening over whichever photograph is up, so the grid, the
         dial and the copy stand off it. Over the photographs in the stack. -->
    <div class="hero-slides__dark"></div>
  </div>
  <div class="home-hero__content">
    <!-- The nav lives in the fixed .site-nav below, which sits in this slot -->
    <div class="home-hero__top"></div>
    <!-- The runner: a fine rule of short vertical strokes through the middle
         of the hero, bent by the pointer. Empty in the markup — hero-runner.js
         puts a canvas in it. -->
    <div class="hero-runner" data-hero-runner aria-hidden="true"></div>
    <!-- The dial: a ring of radial ticks and a framed photograph, fixed on
         the intersection of the runner and the fourth of its five strong
         lines. The ticks light in turn, clockwise, over five seconds — the
         autoplay's clock, drawn — and at the full circle hero-dial.js moves
         on to the next of its five states, whose photographs the hero and
         the dial's centre change to; the pointer over the dial holds the
         clock. One caption per state, in column order, swapped with the
         photographs; captions and photographs are the Studio's Dial slides. -->
    <div class="hero-dial" data-hero-dial>
      <!-- The centre: a round frame with one photograph per column line,
           slid across it by hero-dial.js in step with the backgrounds. Before
           the face in the markup so the face's pointer circle sits over it. -->
      <div data-hero-dial-mask class="hero-dial__mask">
        {hero.slides.map((slide) => (
        <div data-hero-dial-mask-item class="hero-dial__mask-item">{slide.photo && <img src={urlFor(slide.photo).width(800).url()} draggable="false" class="hero-dial__mask-img" alt="">}</div>
        ))}
      </div>
      <svg class="hero-dial__face" viewBox="-250 -250 500 500" aria-hidden="true" focusable="false">
        <g class="hero-dial__ticks">
          {Array.from({ length: 72 }, (_, i) => (
            <line x1="0" y1="-230" x2="0" y2="-206" transform={`rotate(${i * 5})`} />
          ))}
        </g>
        <circle class="hero-dial__pause" r="230" />
      </svg>
      <div class="hero-dial__note">
        <span class="hero-dial__note-marker"></span>
        <div class="hero-dial__captions">
          {hero.slides.map((slide) => (
            <p data-hero-dial-caption>{slide.caption}</p>
          ))}
        </div>
      </div>
    </div>
    <div class="home-hero__bottom">
      <div class="home-hero__copy">
        <div class="home-hero__col">
          <div class="home-hero__reveal-mask" data-hero-parallax-lead="0.5">
            <h1 class="home-hero__title home-hero__reveal">{hero.headline}</h1>
          </div>
        </div>
        <!-- The CTAs take the right-hand half of the grid: one site column
             each, so Collaborate sits on dev columns 7–9 and About on 10–12.
             The `.actions` rules pull the first out to the column line and
             the last out to the gutter line. -->
        <div class="home-hero__col is--end">
          <div class="home-hero__reveal-mask is--actions">
            <div class="actions home-hero__reveal">
              <Button href="#contact" data-panel-open="contact" data-barba-prevent="self" label={hero.primaryButton ?? 'Collaborate'} />
              <Button href="/influence" label={hero.secondaryButton ?? 'About'} />
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
<div data-hero-parallax-dark class="home-hero-wrap__dark"></div>
</div>

<!-- Client logo wall under the hero: a tall red band, the eyebrow and one
     black hairline at its top, the logo strip in the open space below. The
     strip is the site's logo marquee (marquee.js; the Partner page has the
     same one), dressed down here: black marks, no tiles. The logos are white
     artwork, turned black in CSS; they come from the Studio's Clients list,
     scaled to fit inside 600 by 240, well over the size the strip shows them
     at. ignoreImageParams keeps the URL builder from cropping each logo to that
     box's shape; logos have no crop of their own to lose. -->
<section class="logo-marquee logo-wall" data-home-section="logoWall">
  <div class="logo-wall__head">
    <p class="tagline logo-wall__eyebrow">[&nbsp;{logoWall.label}&nbsp;]</p>
  </div>
  <div class="logo-wall__body">
  <div data-marquee-duplicate="2" data-marquee-scroll-direction-target data-marquee-direction="left" data-marquee-status="normal" data-marquee-speed="15" data-marquee-scroll-speed="10" class="marquee-advanced">
    <div data-marquee-scroll-target class="marquee-advanced__scroll">
      <div data-marquee-collection-target class="marquee-advanced__collection">
        {clients.map((client) => client.logo && (
          <div class="marquee-advanced__item-width"><img src={urlFor(client.logo).ignoreImageParams().width(600).height(240).url()} loading="lazy" alt={client.name ?? ''}></div>
        ))}
      </div>
    </div>
  </div>
  </div>
</section>

<SiteNav overHero />

<!-- Practice -->
<section class="section" data-home-section="practice">
  <div class="container container-narrow">
    <p class="tagline">{practice.label}</p>
    <h2>{practice.statement}</h2>
  </div>
</section>

<!-- Parallax image gallery (gallery.js): the photos stacked full size, the
     same photos again as the thumbnails that pick one -->
<section class="section" data-home-section="slider">
  <div class="container">
    <div data-slideshow="wrap" class="img-slider">
      <div class="img-slider__list">
        {slider.images.map((image, i) => (
        <div data-slideshow="slide" class:list={['img-slide', { 'is--current': i === 0 }]}><img data-slideshow="parallax" alt={image.alt ?? ''} src={urlFor(image).width(2000).url()} draggable="false" class="img-slide__inner"></div>
        ))}
      </div>
      <div class="img-slider__nav">
        {slider.images.map((image, i) => (
        <div data-slideshow="thumb" class:list={['img-slider__thumb', { 'is--current': i === 0 }]}><img src={urlFor(image).width(240).url()} class="slider-thumb__img"></div>
        ))}
      </div>
    </div>
  </div>
</section>

<!-- Recognition -->
<section class="section" data-home-section="recognition">
  <div class="container">
    <div class="two-col">
      <div>
        <p class="tagline">{recognition.label}</p>
        <h2>{recognition.heading}</h2>
      </div>
      <div class="two-col-offset">
        <p class="lead">{recognition.lead}</p>
        <div class="actions">
          <Button href="/influence" label={recognition.button ?? ''} />
        </div>
      </div>
    </div>

    <!-- Three cards, each a step lower than the one before -->
    <div class="cards">
      {recognition.cards.map((card, i) => (
      <div class:list={['card', i > 0 && `card-offset-${i}`]}>
        {card.image && <img class="card-img" src={urlFor(card.image).width(1200).url()} alt={card.image.alt ?? ''}>}
        <h3>{card.title}</h3>
        <p>{card.text}</p>
      </div>
      ))}
    </div>
  </div>
</section>

<!-- The four photo bands: Influence, Partners, Architecture and the Shop -->
{galleries.map(({ name, gallery, href }) => (
<section class="section" data-home-section={name}>
  <div class="container">
    <div class="section-title">
      <h2>{gallery.heading}</h2>
      <p class="lead">{gallery.lead}</p>
    </div>
    <div class="gallery">
      {gallery.images?.map((image) => (
      <img src={urlFor(image).width(1200).url()} alt={image.alt ?? ''}>
      ))}
    </div>
    <div class="actions actions-end">
      <Button href={href} label={gallery.button ?? ''} />
    </div>
  </div>
</section>
))}

<GetInTouch />


<SiteFooter />

<ContactPanel />
</BaseLayout>
