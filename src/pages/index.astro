---
import BaseLayout from '../layouts/BaseLayout.astro';
import SiteNav from '../components/SiteNav.astro';
import SiteFooter from '../components/SiteFooter.astro';
import ContactPanel from '../components/ContactPanel.astro';
import Button from '../components/Button.astro';
import { sanityClient } from '../sanity/client';
import { urlFor } from '../sanity/image';
import { CLIENT_LOGOS_QUERY } from '../sanity/queries';

// The logo wall's clients, from Sanity, in the order set in the Studio
const clients = await sanityClient.fetch(CLIENT_LOGOS_QUERY);
---
<BaseLayout title="Tomrow Studios" namespace="index" pageName="Home">
<!-- Home hero, in the reveal-parallax wrapper: the section after it slides
     up over it (footer.js) -->
<div data-hero-parallax class="home-hero-wrap">
<section data-hero-parallax-inner class="home-hero">
  <!-- The hero's backgrounds, one per line of the dial. hero-dial.js
       crossfades them as the dial moves — the layered-slider treatment, on
       the dial's own index. Two photographs, alternated across the five
       states, so every move changes the picture except the wrap from the
       last state back to the first. -->
  <div class="hero-slides" data-hero-slides aria-hidden="true">
    <div data-hero-slide-bg class="hero-slides__item"><img src="assets/photos/backgrounds/background-01.jpg" class="hero-slides__img" alt=""></div>
    <div data-hero-slide-bg class="hero-slides__item"><img src="assets/photos/backgrounds/background-02.jpg" class="hero-slides__img" alt=""></div>
    <div data-hero-slide-bg class="hero-slides__item"><img src="assets/photos/backgrounds/background-01.jpg" class="hero-slides__img" alt=""></div>
    <div data-hero-slide-bg class="hero-slides__item"><img src="assets/photos/backgrounds/background-02.jpg" class="hero-slides__img" alt=""></div>
    <div data-hero-slide-bg class="hero-slides__item"><img src="assets/photos/backgrounds/background-01.jpg" class="hero-slides__img" alt=""></div>
    <!-- A flat darkening over whichever photograph is up, so the grid, the
         dial and the copy stand off it. Over the photographs in the stack. -->
    <div class="hero-slides__dark"></div>
  </div>
  <div class="home-hero__content">
    <!-- The nav lives in the fixed .site-nav below, which sits in this slot -->
    <div class="home-hero__top"></div>
    <!-- The runner: a fine rule of short vertical strokes through the middle
         of the hero, bent by the pointer. Empty in the markup — hero-runner.js
         puts a canvas in it. -->
    <div class="hero-runner" data-hero-runner aria-hidden="true"></div>
    <!-- The dial: a ring of radial ticks and a framed photograph, fixed on
         the intersection of the runner and the fourth of its five strong
         lines. The ticks light in turn, clockwise, over five seconds — the
         autoplay's clock, drawn — and at the full circle hero-dial.js moves
         on to the next of its five states, whose photographs the hero and
         the dial's centre change to; the pointer over the dial holds the
         clock. One caption per state, in column order, swapped with the
         photographs; placeholder copy. -->
    <div class="hero-dial" data-hero-dial>
      <!-- The centre: a round frame with one photograph per column line,
           slid across it by hero-dial.js in step with the backgrounds. Before
           the face in the markup so the face's pointer circle sits over it. -->
      <div data-hero-dial-mask class="hero-dial__mask">
        <div data-hero-dial-mask-item class="hero-dial__mask-item"><img src="assets/photos/portraits/portrait-01.jpg" draggable="false" class="hero-dial__mask-img" alt=""></div>
        <div data-hero-dial-mask-item class="hero-dial__mask-item"><img src="assets/photos/verticals/vertical-01.jpg" draggable="false" class="hero-dial__mask-img" alt=""></div>
        <div data-hero-dial-mask-item class="hero-dial__mask-item"><img src="assets/photos/portraits/portrait-02.jpg" draggable="false" class="hero-dial__mask-img" alt=""></div>
        <div data-hero-dial-mask-item class="hero-dial__mask-item"><img src="assets/photos/studio/studio-02.jpg" draggable="false" class="hero-dial__mask-img" alt=""></div>
        <div data-hero-dial-mask-item class="hero-dial__mask-item"><img src="assets/photos/verticals/vertical-02.jpg" draggable="false" class="hero-dial__mask-img" alt=""></div>
      </div>
      <svg class="hero-dial__face" viewBox="-250 -250 500 500" aria-hidden="true" focusable="false">
        <g class="hero-dial__ticks">
          {Array.from({ length: 72 }, (_, i) => (
            <line x1="0" y1="-230" x2="0" y2="-206" transform={`rotate(${i * 5})`} />
          ))}
        </g>
        <circle class="hero-dial__pause" r="230" />
      </svg>
      <div class="hero-dial__note">
        <span class="hero-dial__note-marker"></span>
        <div class="hero-dial__captions">
          {[
            "Architecture drawn by hand.",
            "Content made to be shared.",
            "Education in the studio.",
            "Design for a global audience.",
            "Work that travels."
          ].map((caption) => (
            <p data-hero-dial-caption>{caption}</p>
          ))}
        </div>
      </div>
    </div>
    <div class="home-hero__bottom">
      <div class="home-hero__copy">
        <div class="home-hero__col">
          <div class="home-hero__reveal-mask" data-hero-parallax-lead="0.5">
            <h1 class="home-hero__title home-hero__reveal">Architecture, content Education for a global audience.</h1>
          </div>
        </div>
        <!-- The CTAs take the right-hand half of the grid: one site column
             each, so Collaborate sits on dev columns 7–9 and About on 10–12.
             The `.actions` rules pull the first out to the column line and
             the last out to the gutter line. -->
        <div class="home-hero__col is--end">
          <div class="home-hero__reveal-mask is--actions">
            <div class="actions home-hero__reveal">
              <Button href="#contact" data-panel-open="contact" data-barba-prevent="self" label="Collaborate" />
              <Button href="influence.html" label="About" />
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
<div data-hero-parallax-dark class="home-hero-wrap__dark"></div>
</div>

<!-- Client logo wall under the hero: a tall red band, the eyebrow and one
     black hairline at its top, the logo strip in the open space below. The
     strip is the site's logo marquee (marquee.js; the Partner page has the
     same one), dressed down here: black marks, no tiles. The logos are white
     artwork, turned black in CSS; they come from the Studio's Clients list,
     scaled to fit inside 600 by 240, well over the size the strip shows them
     at. ignoreImageParams keeps the URL builder from cropping each logo to that
     box's shape; logos have no crop of their own to lose. -->
<section class="logo-marquee logo-wall">
  <div class="logo-wall__head">
    <p class="tagline logo-wall__eyebrow">[&nbsp;Clients&nbsp;]</p>
  </div>
  <div class="logo-wall__body">
  <div data-marquee-duplicate="2" data-marquee-scroll-direction-target data-marquee-direction="left" data-marquee-status="normal" data-marquee-speed="15" data-marquee-scroll-speed="10" class="marquee-advanced">
    <div data-marquee-scroll-target class="marquee-advanced__scroll">
      <div data-marquee-collection-target class="marquee-advanced__collection">
        {clients.map((client) => (
          <div class="marquee-advanced__item-width"><img src={urlFor(client.logo).ignoreImageParams().width(600).height(240).url()} loading="lazy" alt={client.name ?? ''}></div>
        ))}
      </div>
    </div>
  </div>
  </div>
</section>

<SiteNav overHero />

<!-- Practice -->
<section class="section">
  <div class="container container-narrow">
    <p class="tagline">Practice</p>
    <h2>Tom Rowntree is an architectural designer, author and content strategist. His work translates the discipline for a wider world, shaping conversations and connecting ideas with clarity.</h2>
  </div>
</section>

<!-- Parallax image gallery -->
<section class="section">
  <div class="container">
    <div data-slideshow="wrap" class="img-slider">
      <div class="img-slider__list">
        <div data-slideshow="slide" class="img-slide is--current"><img data-slideshow="parallax" alt="" src="assets/photos/thumbnails/thumb-04.jpg" draggable="false" class="img-slide__inner"></div>
        <div data-slideshow="slide" class="img-slide"><img data-slideshow="parallax" alt="" src="assets/photos/thumbnails/thumb-05.jpg" draggable="false" class="img-slide__inner"></div>
        <div data-slideshow="slide" class="img-slide"><img data-slideshow="parallax" alt="" src="assets/photos/thumbnails/thumb-06.jpg" draggable="false" class="img-slide__inner"></div>
        <div data-slideshow="slide" class="img-slide"><img data-slideshow="parallax" alt="" src="assets/photos/thumbnails/thumb-07.jpg" draggable="false" class="img-slide__inner"></div>
      </div>
      <div class="img-slider__nav">
        <div data-slideshow="thumb" class="img-slider__thumb is--current"><img src="assets/photos/thumbnails/thumb-04.jpg" class="slider-thumb__img"></div>
        <div data-slideshow="thumb" class="img-slider__thumb"><img src="assets/photos/thumbnails/thumb-05.jpg" class="slider-thumb__img"></div>
        <div data-slideshow="thumb" class="img-slider__thumb"><img src="assets/photos/thumbnails/thumb-06.jpg" class="slider-thumb__img"></div>
        <div data-slideshow="thumb" class="img-slider__thumb"><img src="assets/photos/thumbnails/thumb-07.jpg" class="slider-thumb__img"></div>
      </div>
    </div>
  </div>
</section>

<!-- Recognition -->
<section class="section">
  <div class="container">
    <div class="two-col">
      <div>
        <p class="tagline">Recognition</p>
        <h2>Awards, recognition and achievements</h2>
      </div>
      <div class="two-col-offset">
        <p class="lead">Shortlisted by RIBA and the AJ. Published by RIBA Publishing and selected for the Dezeen School Shows. An audience of over 180,000 follows the conversation across platforms.</p>
        <div class="actions">
          <Button href="influence.html" label="About" />
        </div>
      </div>
    </div>

    <div class="cards">
      <div class="card">
        <img class="card-img" src="assets/photos/thumbnails/thumb-01.jpg" alt="">
        <h3>Awards and nominations</h3>
        <p>RIBA and AJ recognition for projects that value clarity over spectacle.</p>
      </div>
      <div class="card card-offset-1">
        <img class="card-img" src="assets/photos/thumbnails/thumb-02.jpg" alt="">
        <h3>Publishing and exhibitions</h3>
        <p>A book with RIBA Publishing and selection for the Dezeen School Shows.</p>
      </div>
      <div class="card card-offset-2">
        <img class="card-img" src="assets/photos/thumbnails/thumb-03.jpg" alt="">
        <h3>Speaking and collaboration</h3>
        <p>Talks and partnerships with leading architecture, design, and technology organisations.</p>
      </div>
    </div>
  </div>
</section>

<!-- Gallery: Architectural Influence -->
<section class="section">
  <div class="container">
    <div class="section-title">
      <h2>Architectural Influence</h2>
      <p class="lead">Architecture travels further when it is shared with clarity.</p>
    </div>
    <div class="gallery">
      <img src="assets/photos/events/event-01.jpg" alt="">
      <img src="assets/photos/events/event-02.jpg" alt="">
      <img src="assets/photos/events/event-03.jpg" alt="">
      <img src="assets/photos/events/event-04.jpg" alt="">
    </div>
    <div class="actions actions-end">
      <Button href="influence.html" label="Explore Influence" />
    </div>
  </div>
</section>

<!-- Gallery: Selected partners -->
<section class="section">
  <div class="container">
    <div class="section-title">
      <h2>Selected partners</h2>
      <p class="lead">Strategic work with organisations that shape the built environment.</p>
    </div>
    <div class="gallery">
      <img src="assets/photos/studio/studio-01.jpg" alt="">
      <img src="assets/photos/studio/studio-02.jpg" alt="">
      <img src="assets/photos/studio/studio-03.jpg" alt="">
      <img src="assets/photos/studio/studio-04.jpg" alt="">
    </div>
    <div class="actions actions-end">
      <Button href="partner.html" label="View Partners" />
    </div>
  </div>
</section>

<!-- Gallery: Architectural Projects -->
<section class="section">
  <div class="container">
    <div class="section-title">
      <h2>Architectural Projects</h2>
      <p class="lead">Drawings, models, and spaces that earned their place in the conversation.</p>
    </div>
    <div class="gallery">
      <img src="assets/photos/lifestyle/lifestyle-01.jpg" alt="">
      <img src="assets/photos/lifestyle/lifestyle-02.jpg" alt="">
      <img src="assets/photos/lifestyle/lifestyle-03.jpg" alt="">
      <img src="assets/photos/lifestyle/lifestyle-04.jpg" alt="">
    </div>
    <div class="actions actions-end">
      <Button href="architecture.html" label="View Architecture" />
    </div>
  </div>
</section>

<!-- Gallery: Courses & Resources -->
<section class="section">
  <div class="container">
    <div class="section-title">
      <h2>Courses &amp; Resources</h2>
      <p class="lead">A visual index of work, influence, and the spaces between.</p>
    </div>
    <div class="gallery">
      <img src="assets/photos/talks/talk-03.jpg" alt="">
      <img src="assets/photos/talks/talk-04.jpg" alt="">
      <img src="assets/photos/talks/talk-05.jpg" alt="">
      <img src="assets/photos/talks/talk-06.jpg" alt="">
    </div>
    <div class="actions actions-end">
      <Button href="shop.html" label="Visit the Shop" />
    </div>
  </div>
</section>

<!-- Closing CTA -->
<section class="section final-cta">
  <div class="container">
    <div class="final-cta__inner">
      <p class="tagline final-cta__eyebrow">Get in touch</p>
      <h2 class="final-cta__title">Talk to Tom</h2>
      <span class="final-cta__portrait"><img src="assets/photos/portraits/portrait-01.jpg" width="1200" height="1200" loading="lazy" decoding="async" alt="Tom Rowntree"></span>
      <div class="final-cta__foot">
        <p class="lead final-cta__lead">Speaking, partnerships, teaching or a project you are still working out — start the conversation and Tom will come back to you himself.</p>
        <div class="actions">
          <Button href="#contact" data-panel-open="contact" data-barba-prevent="self" label="Contact Tom" />
        </div>
      </div>
    </div>
  </div>
</section>


<SiteFooter />

<ContactPanel />
</BaseLayout>
