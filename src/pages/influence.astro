---
import StatementBlock from '../components/StatementBlock.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import SiteNav from '../components/SiteNav.astro';
import SiteFooter from '../components/SiteFooter.astro';
import ContactPanel from '../components/ContactPanel.astro';
import WorldMapLines from '../components/WorldMapLines.astro';
import ServiceCards from '../components/ServiceCards.astro';
import { INFLUENCE_PAGE_QUERY } from '../sanity/queries';
import { PAGE_DEFAULTS } from '../sanity/page-defaults';

// The page's words, from the Influence page document (or the page's
// defaults); the hero's photographs are set here. (The page's former
// layout is InfluenceStory.astro, on the Shop page for now.)
const page = await Astro.locals.sanity.fetch(INFLUENCE_PAGE_QUERY);
const D = PAGE_DEFAULTS.influencePage;

// The stepped hero's photographs (style.css, "Influence: the stepped
// hero"): the large photograph on the right, then the steps from the
// highest down to the left edge. `x`, `w`: the panel's left edge and width
// in the composition, as shares of the screen's width (the four side by
// side span it); `step`: its place on the stair, its top that many steps
// below the photograph's (--stage-top, --stage-step); `position`: the
// picture's anchor in its frame. As the page scrolls, every panel goes to
// the same width (EVEN, a quarter), side by side in the same order from
// the left (`xf`), at the screen's full height. The home hero's own
// pictures (public/assets/images/hero, home-hero.ts): Tom speaking (its
// About), then its Architectural Projects, Partners & Collabs and, at the
// left edge, Shop & Courses. `sizes`: how wide each picture is drawn; the steps' pictures
// (3:4) fill the screen's height, wider than their quarter of the screen.
const home = (picture: string) => ({
  src: `/assets/images/hero/hero-${picture}-960.avif`,
  srcset: [480, 720, 960, 1200, 1500].map((width) => `/assets/images/hero/hero-${picture}-${width}.avif ${width}w`).join(', '),
  sizes: 'max(25vw, 75vh)',
});
const panels = [
  {
    x: 0.573, w: 0.427, step: 0,
    src: '/assets/images/hero/hero-about-1500.avif',
    srcset: [960, 1200, 1500].map((width) => `/assets/images/hero/hero-about-${width}.avif ${width}w`).join(', '),
    sizes: '43vw',
    position: '50% 28%',
  },
  { x: 0.334, w: 0.239, step: 1, ...home('projects'), position: '50% 50%' },
  { x: 0.121, w: 0.213, step: 2, ...home('partners'), position: '50% 40%' },
  { x: 0, w: 0.121, step: 3, ...home('shop'), position: '50% 50%' },
];
const EVEN = 1 / panels.length;
// Each panel's place in the even row: its order from the left
const order = panels.map(({ x }) => x).sort((a, b) => a - b);
const stage = panels.map((panel) => ({ ...panel, xf: order.indexOf(panel.x) * EVEN, picture: Math.max(panel.w, EVEN) }));
---
<BaseLayout title="Influence — Tomrowstudios" namespace="influence" pageName="Influence" pageDoc="influencePage">
<!-- The page itself, which shrinks into the footer as the footer arrives
     (footer.js); no column lines on this page (is--gridless) -->
<div class="page-surface is--gridless" data-page-surface>
<SiteNav />

<!-- The stepped hero: a screen tall and a spread more, scrolling with the
     page. Its screen (sticky, held by the browser itself) shows the four
     photographs, which grow with the scroll, over that spread, to four even
     columns of the screen's full height, revealing more of each picture
     (influence.js, initInfluenceStage), and go straight on up with the page
     the moment they are spread; the
     page's name over them, part of the page, scrolling away with it. No
     strip over the bar here or further down (no navPromo). -->
<section class="influence-stage" data-influence-stage aria-label={page?.hero?.heading ?? D.hero.heading}>
  <div class="influence-stage__screen" data-stage-screen>
    {stage.map(({ x, w, step, xf, picture, src, srcset, sizes, position }) => (
    <div class="influence-stage__panel" style={`--x: ${x}; --w: ${w}; --step: ${step}; --xf: ${xf}; --wf: ${EVEN}; --pw: ${picture};`}>
      <img class="influence-stage__img" src={src} srcset={srcset} sizes={sizes} alt="" decoding="async" style={`object-position: ${position};`}>
    </div>
    ))}
  </div>
  <!-- The page's name, and under it, well below, its short description -->
  <div class="influence-stage__text">
    <h1 class="influence-stage__title" data-page-field="hero.heading">{page?.hero?.heading ?? D.hero.heading}</h1>
    <p class="influence-stage__lead" data-page-field="hero.lead">{page?.hero?.lead ?? D.hero.lead}</p>
  </div>
</section>

<!-- The approach, set large (StatementBlock.astro) -->
<section class="section">
  <StatementBlock text={page?.approach?.statement ?? D.approach.statement} field="approach.statement" centred />
</section>

<!-- The line map, the creators' atlas, held in a section of its own for
     now, as it stood behind the page's former hero: the Americas and the
     rest of the world at the screen's two edges (style.css, "Influence:
     the map at the edges"). Nothing else in it. -->
<section class="section influence-atlas" aria-hidden="true">
  <div class="influence-map">
    <div class="influence-map__frame">
      <div class="world-map-stage">
        <WorldMapLines parted />
      </div>
    </div>
  </div>
</section>

<ServiceCards />

</div>

<SiteFooter />

<ContactPanel />
</BaseLayout>
