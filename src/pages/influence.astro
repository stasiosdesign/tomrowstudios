---
import BaseLayout from '../layouts/BaseLayout.astro';
import SiteNav from '../components/SiteNav.astro';
import SiteFooter from '../components/SiteFooter.astro';
import ContactPanel from '../components/ContactPanel.astro';
import Button from '../components/Button.astro';
import WorldMapLines from '../components/WorldMapLines.astro';
import AtlasHotspots from '../components/AtlasHotspots.astro';
import ServiceCards from '../components/ServiceCards.astro';
import BookIcon from '../components/BookIcon.astro';
import { srcSet, urlFor } from '../sanity/image';
import { INFLUENCE_PAGE_QUERY } from '../sanity/queries';
import { PAGE_DEFAULTS } from '../sanity/page-defaults';
import { bookUrl } from '../components/site-links';

// The page's words, from the Influence page document (or the page's
// defaults); the hero's photographs, the timeline, the numbers and the map
// stay here
const page = await Astro.locals.sanity.fetch(INFLUENCE_PAGE_QUERY);
const D = PAGE_DEFAULTS.influencePage;

// The hero's collage (style.css, "Influence: the hero"): thirteen
// photographs from the library, in both datasets, on the geometry of ESE's
// "Discover our history" (eseagency.ch/en/agency), measured from its page
// at three widths. Each of the reference's thirteen frames in its order:
// its left, top and width in vw and its shape (width over height) on a
// desktop (measured at 1440px), a tablet (820px) and a phone (390px), and
// its parallax speed (influence.js, the reference's own). The frames stand
// round the name as they do round the reference's heading: their tops are
// taken from the heading's middle (`head`: the reference heading's middle,
// in vw from its section's top) and set from the name's middle, the middle
// of the first screen. The reference moves a frame by its speed from where
// it stands when the frame is in the middle of the screen, and this page
// from where it stands at the top of the page, with the name in the
// middle; so each frame is set where the reference has it at that moment
// (its offset from the heading's middle, times its speed over ten), and
// the scroll then moves it at the reference's rate. Each photograph is
// placed in the frame nearest its own shape. `tail`: how far the
// reference's section runs on below its heading's middle, in vw.
type Frame = [left: number, top: number, width: number, shape: number];
type Slot = { id: string; speed: number; desktop: Frame; tablet: Frame; phone: Frame };
const layouts = {
  desktop: { head: 74.1, tail: 85.9 },
  tablet: { head: 69.6, tail: 90.4 },
  phone: { head: 130.75, tail: 169.6 },
};
const slots: Slot[] = [
  { id: 'bc89fe633a667a87e845c49f3c6ac5abb3420d2c-1200x1500-jpg', speed: -0.5, desktop: [57, 33.61, 20, 1.5], tablet: [57, 33.7, 20, 1.5], phone: [64.1, 60, 30, 1.5] },
  { id: 'f2d502a355ce58d182036c092964d88dc081c3d2-1200x675-jpg', speed: -1.5, desktop: [33, 95.83, 30, 1.43], tablet: [33, 95.9, 30, 1.43], phone: [52.1, 173.1, 40, 1.43] },
  { id: '0a01c4e2d3ccdc4a01a57a35a87ed4b6f05dc6a9-1600x1600-jpg', speed: 1, desktop: [7, 17.57, 15, 1.33], tablet: [7, 17.6, 15, 1.34], phone: [6.9, 39, 25.1, 1.34] },
  { id: '6d3dd1b7a59b141b839bcaa8b6d932177ba26861-1200x1800-jpg', speed: 2, desktop: [36, 9.58, 20, 0.71], tablet: [36, 0, 20, 0.71], phone: [27.9, 9, 30, 0.7] },
  { id: 'b3ccd88dbff4fe0c6663c9de5395ff04f81c8917-1200x1500-jpg', speed: -2, desktop: [8, 72.99, 20, 1.33], tablet: [3, 44.8, 20, 1.33], phone: [0, 93.1, 30, 1.33] },
  { id: 'e4ea67de175d1e63042eb74536d7cae260fc749c-1200x1500-jpg', speed: 3, desktop: [75, 99.58, 25, 0.79], tablet: [75, 99.6, 25, 0.79], phone: [70, 202.3, 30, 0.79] },
  { id: '5d77103834f2a3f7b2262e797616519e2013297c-1200x1500-jpg', speed: 2, desktop: [16, 52.22, 20, 1.5], tablet: [16, 36.8, 20, 1.5], phone: [15.9, 69, 30, 0.55] },
  { id: 'd6ef53755a50343456775c9a40ee1ae7cb248a22-1200x1800-jpg', speed: 1.5, desktop: [29, 118.96, 20, 0.71], tablet: [29, 118.9, 20, 0.71], phone: [23.1, 227.9, 30, 0.71] },
  { id: '36f402be0bf97c5317c7d97b747b6a6dab83c271-1200x799-jpg', speed: 1, desktop: [70, 64.79, 30, 1.5], tablet: [70, 48, 30, 1.5], phone: [60, 90, 40, 1.5] },
  { id: '5cf058873169d56f24a8f1b8df4df4a5775e2394-1200x675-jpg', speed: 3, desktop: [48, 143.19, 30, 1.5], tablet: [48, 143.2, 30, 1.5], phone: [46.2, 279.7, 40, 1.5] },
  { id: '3b3fee8b11e79a6ee109938ddbf2b463e8d45907-1200x2133-jpg', speed: 3, desktop: [-3, 90.83, 20, 0.56], tablet: [-2, 82.8, 20, 0.56], phone: [-2.1, 169, 30, 0.56] },
  { id: '47972355868e5f78ced56cb0edee370ad0f508c3-1200x1600-jpg', speed: 4, desktop: [75, 14.38, 20, 0.71], tablet: [75, 14.4, 20, 0.71], phone: [66.2, 3.1, 30, 0.7] },
  { id: 'c1d5861d068d9c3f91d90a5ebed6f1632ab6b40b-1200x1500-jpg', speed: 0.5, desktop: [5, 138.54, 25, 1.5], tablet: [5, 138.5, 25, 1.5], phone: [4.1, 274.4, 30, 1.5] },
];
// A frame's place from the name's middle, in vw, at the top of the page
const fromHead = ([, top, width, shape]: Frame, head: number, speed: number) => {
  const middle = top + width / shape / 2;
  return +(top - head + ((middle - head) * speed) / 10).toFixed(2);
};
const shots = slots.map(({ id, speed, desktop, tablet, phone }) => {
  const d = fromHead(desktop, layouts.desktop.head, speed);
  const t = fromHead(tablet, layouts.tablet.head, speed);
  const p = fromHead(phone, layouts.phone.head, speed);
  return {
    id,
    speed,
    style: [
      `--x: ${desktop[0]}; --y: ${d}; --w: ${desktop[2]}; --r: ${desktop[3]};`,
      `--tx: ${tablet[0]}; --ty: ${t}; --tw: ${tablet[2]}; --tr: ${tablet[3]};`,
      `--mx: ${phone[0]}; --my: ${p}; --mw: ${phone[2]}; --mr: ${phone[3]};`,
    ].join(' '),
    sizes: `(max-width: 767px) ${phone[2]}vw, (max-width: 991px) ${tablet[2]}vw, ${desktop[2]}vw`,
    // On or near the first screen: fetched at once
    eager: d < 30,
  };
});
const shotImage = (id: string) => ({ asset: { _id: `image-${id}` } });
// The book band's words, twice four, as the strip over the bar has them
const bookLabel = 'Architectural Influence Book';
---
<BaseLayout title="Influence — Tomrow Studios" namespace="influence" pageName="Influence" pageDoc="influencePage" navPromo="book">
<!-- The page itself, which shrinks into the footer as the footer arrives
     (footer.js); no column lines on this page (is--gridless) -->
<div class="page-surface is--gridless" data-page-surface>
<SiteNav />

<!-- The hero: the page's name in the middle of the first screen, the
     collage round it in parallax (influence.js) -->
<section class="influence-hero" data-influence-hero style={`--tail: ${layouts.desktop.tail}; --ttail: ${layouts.tablet.tail}; --mtail: ${layouts.phone.tail};`}>
  <div class="influence-hero__head">
    <h1 class="influence-hero__title" data-page-field="hero.heading">{page?.hero?.heading ?? D.hero.heading}</h1>
  </div>
  {shots.map(({ id, speed, style, sizes, eager }) => (
  <div class="influence-hero__shot" data-speed={speed} style={style}>
    <img class="influence-hero__img" src={urlFor(shotImage(id)).width(800).url()} srcset={srcSet(shotImage(id), [400, 800, 1200, 1600])} sizes={sizes} alt="" decoding="async" loading={eager ? 'eager' : 'lazy'}>
  </div>
  ))}
</section>

<!-- Total followers — one headline figure -->
<section class="section">
  <div class="container">
    <div data-odometer-group class="figure-lead">
      <p class="tagline" data-page-field="reach.label">{page?.reach?.label ?? D.reach.label}</p>
      <p data-odometer-element data-odometer-duration="2.4" class="figure-lead__number" data-page-field="reach.number">{page?.reach?.number ?? D.reach.number}</p>
      <p class="figure-lead__label" data-page-field="reach.text">{page?.reach?.text ?? D.reach.text}</p>
    </div>
  </div>
</section>

<!-- Approach: the label in the first column, the statement across the rest -->
<section class="section">
  <div class="container lede-row">
    <p class="tagline" data-page-field="approach.label">{page?.approach?.label ?? D.approach.label}</p>
    <h2 data-page-field="approach.statement">{page?.approach?.statement ?? D.approach.statement}</h2>
  </div>
</section>

<!-- Origins / timeline -->
<section class="section section-alt">
  <div class="container">
    <div class="two-col two-col-flat">
      <div>
        <p class="tagline" data-page-field="origins.label">{page?.origins?.label ?? D.origins.label}</p>
        <h2 data-page-field="origins.heading">{page?.origins?.heading ?? D.origins.heading}</h2>
      </div>
      <div>
        <div data-step-timeline-init data-step-timeline-activation="0.5" class="step-timeline">
          <div class="step-timeline__wrapper">
            <div data-step-timeline-line class="step-timeline__line">
              <div data-step-timeline-fill class="step-timeline__fill"></div>
            </div>
            <div class="step-timeline__list">
              <div data-step-timeline-item class="step-timeline__item">
                <div data-step-timeline-marker class="step-timeline__marker"><span>1</span></div>
                <div class="step-timeline__content">
                  <h4 class="step-timeline__content-h">Foundation</h4>
                  <p class="step-timeline__p">The work began in practice. Drawing, making and understanding space formed the bedrock everything else would stand on.</p>
                </div>
              </div>
              <div data-step-timeline-item class="step-timeline__item">
                <div data-step-timeline-marker class="step-timeline__marker"><span>2</span></div>
                <div class="step-timeline__content">
                  <h4 class="step-timeline__content-h">Growth</h4>
                  <p class="step-timeline__p">Content sharpened the thinking. An audience gathered. Courses and workshops turned a personal pursuit into a shared education.</p>
                </div>
              </div>
              <div data-step-timeline-item class="step-timeline__item">
                <div data-step-timeline-marker class="step-timeline__marker"><span>3</span></div>
                <div class="step-timeline__content">
                  <h4 class="step-timeline__content-h">Publication</h4>
                  <p class="step-timeline__p">The book mapped how 21 creators built visibility. It studied deliberate methods, not accidents. The findings changed the conversation.</p>
                </div>
              </div>
              <div data-step-timeline-item class="step-timeline__item">
                <div data-step-timeline-marker class="step-timeline__marker"><span>4</span></div>
                <div class="step-timeline__content">
                  <h4 class="step-timeline__content-h">Expansion</h4>
                  <p class="step-timeline__p">The work now moves through stages, keynotes and industry partnerships. The platform connects education, publishing and strategic collaboration.</p>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- Insights / analytics -->
<section class="section">
  <div class="container">
    <div class="section-head">
      <div class="section-head__main">
        <p class="tagline label-pill" data-page-field="insights.label">{page?.insights?.label ?? D.insights.label}</p>
        <h2 data-page-field="insights.heading">{page?.insights?.heading ?? D.insights.heading}</h2>
      </div>
      <div class="section-head__side">
        <p class="lead" data-page-field="insights.lead">{page?.insights?.lead ?? D.insights.lead}</p>
      </div>
    </div>

    <ul data-odometer-group data-odometer-stagger="0.08" class="insights-list">
      <li class="insights-row">
        <p class="insights-row__index">01</p>
        <div class="insights-row__body">
          <p class="insights-row__label">Instagram</p>
          <p class="insights-row__note">Followers — the core audience, built over seven years</p>
        </div>
        <p data-odometer-element data-odometer-duration="1.6" class="insights-row__value">96,400</p>
      </li>
      <li class="insights-row">
        <p class="insights-row__index">02</p>
        <div class="insights-row__body">
          <p class="insights-row__label">YouTube</p>
          <p class="insights-row__note">Subscribers — long-form explainers, walkthroughs and interviews</p>
        </div>
        <p data-odometer-element data-odometer-duration="1.6" class="insights-row__value">24,800</p>
      </li>
      <li class="insights-row">
        <p class="insights-row__index">03</p>
        <div class="insights-row__body">
          <p class="insights-row__label">Combined audience</p>
          <p class="insights-row__note">A voice built across every platform over seven years</p>
        </div>
        <p data-odometer-element data-odometer-duration="1.6" class="insights-row__value">180,000+</p>
      </li>
      <li class="insights-row">
        <p class="insights-row__index">04</p>
        <div class="insights-row__body">
          <p class="insights-row__label">Publication</p>
          <p class="insights-row__note">Architectural Influence, published by RIBA Publishing — 21 creators across 13 countries</p>
        </div>
        <div class="insights-row__value-group">
          <p class="insights-row__value is--words">Published Book</p>
          <a href="/book" data-split-hover="link" class="insights-row__link"><span data-split-hover="target">See the book</span><span aria-hidden="true">&#8202;&#8594;</span></a>
        </div>
      </li>
      <li class="insights-row">
        <p class="insights-row__index">05</p>
        <div class="insights-row__body">
          <p class="insights-row__label">Recognition</p>
          <p class="insights-row__note">The RIBA West London Architects Group Prize, for a new kind of architectural practice</p>
        </div>
        <p class="insights-row__value is--words">Prize Winner</p>
      </li>
      <li class="insights-row">
        <p class="insights-row__index">06</p>
        <div class="insights-row__body">
          <p class="insights-row__label">Collaboration</p>
          <p class="insights-row__note">RIBA, Meta, Archi-Tech Network and Rayon Design — partnerships beyond the drawing board</p>
        </div>
        <p class="insights-row__value is--words">Industry Partners</p>
      </li>
    </ul>
  </div>
</section>

<!-- Atlas — the map, then the book it came from -->
<section class="map-spread is--influence">
  <div class="map-spread__head">
    <p class="tagline" data-page-field="atlas.label">{page?.atlas?.label ?? D.atlas.label}</p>
    <h2 data-page-field="atlas.heading">{page?.atlas?.heading ?? D.atlas.heading}</h2>
  </div>
  <div class="map-spread__media">
    <!-- The stage is exactly the plate's box, so the hotspot layer inside it
         shares the map's coordinates at any width -->
    <div class="world-map-stage" data-hotspot-area>
      <WorldMapLines />
      <AtlasHotspots />
    </div>
  </div>
  <!-- The book band: the strip over the floating bar, grown to the page's
       width as the section comes up (influence.js), its head -->
  <a href="/book" class="book-band" data-book-band aria-label={bookLabel}>
    <span class="fnav-promo__scale">
      <span class="fnav-promo__track" aria-hidden="true">
        {[0, 1].map(() => (
        <span class="fnav-promo__half">
          {[0, 1, 2, 3].map(() => (
          <span class="fnav-promo__item"><span class="fnav-promo__text">{bookLabel}</span><BookIcon /></span>
          ))}
        </span>
        ))}
      </span>
    </span>
  </a>
  <div class="book-feature">
    <div class="book-feature__intro">
      <p class="tagline" data-page-field="book.label">{page?.book?.label ?? D.book.label}</p>
      <h2 data-page-field="book.heading">{page?.book?.heading ?? D.book.heading}</h2>
    </div>
    <div class="book-feature__body">
      <p class="lead" data-page-field="book.lead">{page?.book?.lead ?? D.book.lead}</p>
      <div class="actions">
        <Button href={bookUrl} target="_blank" rel="noopener" data-page-field="book.button" label={page?.book?.button ?? D.book.button} />
      </div>
    </div>
  </div>
</section>

<ServiceCards />


</div>

<SiteFooter />

<ContactPanel />
</BaseLayout>
