---
import StatementBlock from '../components/StatementBlock.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import SiteNav from '../components/SiteNav.astro';
import SiteFooter from '../components/SiteFooter.astro';
import ContactPanel from '../components/ContactPanel.astro';
import WorldMapLines from '../components/WorldMapLines.astro';
import ServiceCards from '../components/ServiceCards.astro';
import Arrow from '../components/Arrow.astro';
import { INFLUENCE_PAGE_QUERY } from '../sanity/queries';
import { PAGE_DEFAULTS } from '../sanity/page-defaults';

// The page's words, from the Influence page document (or the page's
// defaults); the hero's photographs are set here. (The page's former
// hero, InfluenceStory.astro, is no longer shown anywhere.)
const page = await Astro.locals.sanity.fetch(INFLUENCE_PAGE_QUERY);
const D = PAGE_DEFAULTS.influencePage;

// The stepped hero's photographs (style.css, "Influence: the stepped
// hero"): the large photograph on the right, then the steps from the
// highest down to the left edge. `x`, `w`: the panel's left edge and width
// in the composition, as shares of the screen's width (the four side by
// side span it); `step`: its place on the stair, its top that many steps
// below the photograph's (--stage-top, --stage-step); `position`: the
// picture's anchor in its frame. As the page scrolls, the left one takes
// over the screen, pushing the others aside, and the four run by as a
// gallery, a screen each, in the same order from the left (`i`). The home hero's own
// pictures (public/assets/images/hero, home-hero.ts): Tom speaking (its
// About), then its Architectural Projects, Partners & Collabs and, at the
// left edge, Shop & Courses. `sizes`: how wide each picture is drawn at its
// largest, the whole screen (the gallery the row runs into, style.css).
const home = (picture: string) => ({
  src: `/assets/images/hero/hero-${picture}-960.avif`,
  srcset: [480, 720, 960, 1200, 1500].map((width) => `/assets/images/hero/hero-${picture}-${width}.avif ${width}w`).join(', '),
  sizes: '100vw',
});
const panels = [
  {
    x: 0.573, w: 0.427, step: 0,
    src: '/assets/images/hero/hero-about-1500.avif',
    srcset: [960, 1200, 1500].map((width) => `/assets/images/hero/hero-about-${width}.avif ${width}w`).join(', '),
    sizes: '100vw',
    position: '50% 28%',
  },
  { x: 0.334, w: 0.239, step: 1, ...home('projects'), position: '50% 50%' },
  { x: 0.121, w: 0.213, step: 2, ...home('partners'), position: '50% 40%' },
  { x: 0, w: 0.121, step: 3, ...home('shop'), position: '50% 50%' },
];
// The gallery's words, one to a picture, left to right: the four parts of
// Tom's architectural influence, each growing out of the one before (the
// work, the content made from it, the audience the content built, and the
// opportunities that visibility brings). `lines`: where a name breaks, if
// it is set by hand rather than left to the measure. `cta`: a quiet link
// under the name, to a page, or `contact`, opening the contact form out
// of the floating bar as every Contact does (floatingnav.js)
type Cta = { label: string; href: string; contact?: boolean };
const CAPTIONS: { title: string; lines?: string[]; text: string; cta?: Cta }[] = [
  { title: 'Architectural Work', lines: ['Architectural', 'Work'], cta: { label: 'View Work', href: '/architecture' }, text: 'Tom’s architectural education, projects and professional experience give the platform its subject matter and credibility.' },
  { title: 'Architectural Content', lines: ['Architectural', 'Content'], text: 'Tom translates architecture into video, writing, social media and other formats that make the work easier to discover and engage with.' },
  { title: 'Building an Audience', lines: ['Building', 'an Audience'], text: 'That content has built a substantial audience around architecture, connecting Tom with students, professionals, practices and the wider industry.' },
  { title: 'Publishing, Speaking & Collaboration', cta: { label: 'Collaborate with Tom', href: '#contact', contact: true }, text: 'That visibility now extends into books, talks, events, education and collaborations with organisations across architecture and design.' },
];
// Each panel's place from the left (0 to 3): in the gallery, the screens
// before it
const order = panels.map(({ x }) => x).sort((a, b) => a - b);
const stage = panels.map((panel) => ({ ...panel, i: order.indexOf(panel.x) }));
---
<BaseLayout title="Influence — Tomrowstudios" namespace="influence" pageName="Influence" pageDoc="influencePage" navPromo="book">
<!-- The page itself, which shrinks into the footer as the footer arrives
     (footer.js); no column lines on this page (is--gridless) -->
<div class="page-surface is--gridless" data-page-surface>
<SiteNav />

<!-- The stepped hero: a screen tall and its sequence's scroll more,
     scrolling with the page. Its screen (sticky, held by the browser
     itself) shows the four photographs: with the scroll the left one
     widens until it fills the screen, pushing the others aside, each only
     revealing more of a photograph that holds still, and the four run by
     as a gallery, a screen each, before the screen goes on up with the
     page (influence.js, initInfluenceStage); the
     page's name over them, part of the page, scrolling away with it. The
     page asks for the book's strip over the floating bar (navPromo), as it
     always has; none over the stage (data-nav-promo empty), so it comes up
     once the gallery has run and let the page go on, after the gallery's
     own line over the bar has gone. -->
<section class="influence-stage" data-influence-stage data-nav-promo="" aria-label={page?.hero?.heading ?? D.hero.heading}>
  <div class="influence-stage__screen" data-stage-screen>
    {stage.map(({ x, w, step, i, src, srcset, sizes, position }) => (
    <div class="influence-stage__panel" style={`--x: ${x}; --w: ${w}; --step: ${step}; --i: ${i};`}>
      <img class="influence-stage__img" src={src} srcset={srcset} sizes={sizes} alt="" decoding="async" style={`object-position: ${position};`}>
    </div>
    ))}
    <!-- Each picture's words in the gallery the row runs into, left to
         right as the pictures are: its name large on the page's name's
         edge, under it on two of them a quiet link (the hero's Learn more,
         style.css), its line on the pages' column, the lit one's brought
         into place as its picture fills the screen (influence.js) -->
    <div class="influence-stage__captions">
      {CAPTIONS.map(({ title, lines, text, cta }, k) => (
      <div class="influence-stage__caption" data-stage-caption={k}>
        <div class="influence-stage__caption-head">
          <h2 class="influence-stage__caption-title">{(lines ?? [title]).map((line, j) => <>{j > 0 && <br />}{line}</>)}</h2>
          {cta && (
          <a href={cta.href} class="home-list__cta influence-stage__cta" {...(cta.contact ? { 'data-fnav-contact-open': '', 'data-barba-prevent': 'self', 'aria-haspopup': 'dialog', 'aria-controls': 'fnav-contact' } : {})}>
            <span class="home-list__cta-label">{cta.label}</span>
            <Arrow class="home-list__cta-arrow" shape="straight" />
          </a>
          )}
        </div>
        <p class="influence-stage__caption-text">{text}</p>
      </div>
      ))}
    </div>
  </div>
  <!-- How far through the gallery: a fine line just over the floating bar,
       as wide as it, filling with the run and there only while the run
       is (influence.js, --run) -->
  <div class="influence-stage__progress" data-stage-progress aria-hidden="true"><span class="influence-stage__progress-fill"></span></div>
  <!-- The page's name, and under it, well below, its short description -->
  <div class="influence-stage__text">
    <h1 class="influence-stage__title" data-page-field="hero.heading">{page?.hero?.heading ?? D.hero.heading}</h1>
    <p class="influence-stage__lead" data-page-field="hero.lead">{page?.hero?.lead ?? D.hero.lead}</p>
  </div>
</section>

<!-- After the gallery, three parts of the page still to come, each a
     screen with only its name for now (style.css, "Influence: the parts
     to come"): Tom's background and how Tomrow Studios came about; the
     Architectural Influence book; and the studio today, its reach and
     milestones. Then the page as it was. -->
{['The Story Behind Tomro Studios', 'Architectural Influence', 'Tomro Studios Today'].map((title) => (
<section class="section influence-part">
  <h2 class="influence-part__title">{title}</h2>
</section>
))}

<!-- The approach, set large (StatementBlock.astro); its words light up as
     it is scrolled through, as the home page's statement's do
     (text-highlight.js) -->
<section class="section">
  <StatementBlock text={page?.approach?.statement ?? D.approach.statement} field="approach.statement" centred highlight />
</section>

<!-- The line map, the creators' atlas, held in a section of its own for
     now, as it stood behind the page's former hero: the Americas and the
     rest of the world at the screen's two edges (style.css, "Influence:
     the map at the edges"). Nothing else in it. -->
<section class="section influence-atlas" aria-hidden="true">
  <div class="influence-map">
    <div class="influence-map__frame">
      <div class="world-map-stage">
        <WorldMapLines parted />
      </div>
    </div>
  </div>
</section>

<ServiceCards />

</div>

<SiteFooter />

<ContactPanel />
</BaseLayout>
