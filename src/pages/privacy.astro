---
import { PortableText } from 'astro-portabletext';
import BaseLayout from '../layouts/BaseLayout.astro';
import SiteNav from '../components/SiteNav.astro';
import SiteFooter from '../components/SiteFooter.astro';
import ContactPanel from '../components/ContactPanel.astro';
import { PRIVACY_PAGE_QUERY } from '../sanity/queries';
import { contentParams } from '../sanity/content';
import { PAGE_DEFAULTS } from '../sanity/page-defaults';

// The page's title, and its text once it is written, from the Privacy page
// document (or the page's defaults)
const page = await Astro.locals.sanity.fetch(PRIVACY_PAGE_QUERY, contentParams);
const D = PAGE_DEFAULTS.privacyPage;
---
<BaseLayout title="Privacy — Tomrow Studios" namespace="privacy" pageName="Privacy" pageDoc="privacyPage">
<SiteNav />


<!-- Header -->
<header class="page-header">
  <div class="page-header-body">
    <div class="page-header-main">
      <h1 data-page-field="header.heading">{page?.header?.heading ?? D.header.heading}</h1>
    </div>
  </div>
</header>

<!-- The text, once there is one -->
{page?.body?.length ? (
<section class="section">
  <div class="container container-narrow">
    <div class="rich-text"><PortableText value={page.body} /></div>
  </div>
</section>
) : null}


<SiteFooter />

<ContactPanel />
</BaseLayout>
