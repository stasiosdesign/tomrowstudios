---
import BaseLayout from '../layouts/BaseLayout.astro';
import SiteNav from '../components/SiteNav.astro';
import ContactPanel from '../components/ContactPanel.astro';
import Button from '../components/Button.astro';
---
<BaseLayout title="Sets in Motion: Architecture and the Spatial Arts of Cinema — Tomrow Studios" namespace="project-sets" pageName="Sets in Motion">
<SiteNav />


<!-- Project header. The title takes the top of the page on its own; the rule
     under it separates the standfirst from the awards, so the two read as a
     row rather than one long pile of stacked blocks. -->
<header class="project-hero">
  <p class="tagline project-hero__eyebrow">Architecture — MArch 1 — 2022</p>
  <h1 class="project-hero__title">Sets in Motion: Architecture and the Spatial Arts of Cinema</h1>
  <div class="project-hero__meta">
    <p class="project-hero__lead">Vision through framing, and the picturesque nature of the Alexandra Palace Park landscape.</p>
    <div class="project-hero__side">
    <ul class="award-labels">
      <li class="award-label is--won"><span class="award-label__name">RIBA West London Architects Group Prize</span><span class="award-label__note">Winner 2022</span></li>
      <li class="award-label"><span class="award-label__name">Dezeen School Shows</span><span class="award-label__note">Selected 2023</span></li>
      <li class="award-label is--meta"><span class="award-label__name">MArch 1</span></li>
      <li class="award-label is--meta"><span class="award-label__name">University of Westminster</span></li>
      <li class="award-label is--meta"><span class="award-label__name">2022</span></li>
    </ul>
      <div class="actions project-hero__actions">
        <Button href="https://www.tomrowstudios.com/_files/ugd/746e36_96da3bca143149729bd5c9678fb3809b.pdf" target="_blank" rel="noopener" label="Download Portfolio" />
        <Button href="architecture.html" label="All projects" secondary />
      </div>
    </div>
  </div>
</header>

<!-- Full bleed -->
<section class="project-bleed">
  <img data-click-zoom src="assets/projects/sets-in-motion/01.jpg" width="1600" height="902" loading="lazy" decoding="async" alt="Sets in Motion — plate 1">
</section>

<!-- Image band, on the four-column grid -->
<section class="project-grid">
  <div class="masonry-wrap">
    <div class="masonry-collection">
      <div data-masonry-list data-masonry-shuffle="false" class="masonry-list">
        <div class="masonry-item">
          <div data-click-zoom class="masonry-item__visual is--wide">
            <img src="assets/projects/sets-in-motion/02.jpg" width="1599" height="901" loading="lazy" decoding="async" alt="Sets in Motion — plate 2" class="masonry-item__visual-img">
          </div>
        </div>
        <div class="masonry-item">
          <div data-click-zoom class="masonry-item__visual is--wide">
            <img src="assets/projects/sets-in-motion/03.jpg" width="1600" height="902" loading="lazy" decoding="async" alt="Sets in Motion — plate 3" class="masonry-item__visual-img">
          </div>
        </div>
        <div class="masonry-item">
          <div data-click-zoom class="masonry-item__visual is--wide">
            <img src="assets/projects/sets-in-motion/04.jpg" width="1600" height="902" loading="lazy" decoding="async" alt="Sets in Motion — plate 4" class="masonry-item__visual-img">
          </div>
        </div>
        <div class="masonry-item">
          <div data-click-zoom class="masonry-item__visual is--wide">
            <img src="assets/projects/sets-in-motion/05.jpg" width="1600" height="902" loading="lazy" decoding="async" alt="Sets in Motion — plate 5" class="masonry-item__visual-img">
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- Full bleed -->
<section class="project-bleed">
  <img data-click-zoom src="assets/projects/sets-in-motion/06.jpg" width="1600" height="902" loading="lazy" decoding="async" alt="Sets in Motion — plate 6">
</section>

<!-- Overview -->
<section class="project-note">
  <div class="project-note__inner">
    <p class="tagline">The project</p>
    <div class="project-note__body">
        <p>Sets in Motion explores vision through framing and the picturesque nature of the Alexandra Palace Park landscape. A body of research in cinema has led me to propose an independent filmmaker facility where the architecture and landscape become a backdrop for content.</p>
        <p>A series of points of view site mappings creates a drawing system that guides the proposal and creates pockets of solid and void. The proposal utilises the level change of the park by being integrated into the slope and maintains views over the panorama.</p>
        <p>It was key to celebrate the park's community and provide a facility that is fully accessible from all areas of the landscape. The facility allows independent filmmakers to take the entire process of producing a film, from planning to marketing.</p>
    </div>
  </div>
</section>

