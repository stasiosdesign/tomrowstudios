    </div>
    <div class="scroll-next__progres">
      <svg xmlns="http://www.w3.org/2000/svg" width="100%" viewbox="0 0 480 480" fill="none" class="scroll-next__progres-svg"><circle opacity="0.4" cx="240" cy="240" r="240" stroke="currentColor" stroke-width="3"></circle><circle opacity="1" cx="240" cy="240" r="240" stroke="currentColor" stroke-width="3" data-scroll-next-path></circle></svg>
