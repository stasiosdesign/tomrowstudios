---
/* One page per architecture project, from Sanity at /projects/<slug> (the
   old /project-<slug>.html addresses redirect here; see vercel.ts). The
   markup is the hand-written project pages' own, section for section; which
   sections a project has, their order, and which project comes next are set
   in the Studio.

   Production builds a page for each published project. Staging renders the
   page on request, where Astro has no use for getStaticPaths, so there it is
   left out; a project that is still a draft has a page there in draft mode. */
import type { GetStaticPaths } from 'astro';
import { PortableText } from 'astro-portabletext';
import BaseLayout from '../../layouts/BaseLayout.astro';
import SiteNav from '../../components/SiteNav.astro';
import ContactPanel from '../../components/ContactPanel.astro';
import { sanityClient } from '../../sanity/client';
import { imageAttrs } from '../../sanity/image';
import { PROJECT_INDEX_QUERY, PROJECT_PAGE_QUERY } from '../../sanity/queries';

export const getStaticPaths = __DEPLOYMENT__ === 'production'
  ? ((async () => {
      const projects = await sanityClient.fetch(PROJECT_INDEX_QUERY);
      return projects.map((project) => ({ params: { slug: project.slug as string } }));
    }) satisfies GetStaticPaths)
  : undefined;

// (Typed here: Astro can't infer the params from a getStaticPaths only production has)
const { slug = '' } = Astro.params as { slug?: string };
const { sanity } = Astro.locals;
const [project, projects] = await Promise.all([
  sanity.fetch(PROJECT_PAGE_QUERY, { slug }),
  sanity.fetch(PROJECT_INDEX_QUERY),
]);
if (!project) return new Response('Not found', { status: 404 });

// The next project on the Architecture slider, wrapping round at the end
const next = projects.length > 1 ? projects[(projects.findIndex((p) => p._id === project._id) + 1) % projects.length] : null;

// The facts beside the title, a row each, empty rows left out: the
// project, its context, the plain credits (the school, the subject; not
// the context or the year again), the prizes with how each went, the year
const credits = project.credits ?? [];
const said = new Set([project.context, project.year].filter(Boolean).map(String));
const details = credits.filter((c) => (c.kind ?? 'detail') === 'detail' && c.name && !said.has(c.name)).map((c) => ({ name: c.name, note: c.note }));
const prizes = credits.filter((c) => c.kind === 'won' || c.kind === 'award').map((c) => ({ name: c.name, note: c.note }));
type Fact = { label: string; lines: { name?: string | null; note?: string | null }[] };
const facts: Fact[] = ([
  { label: 'Project', lines: [{ name: project.name }] },
  { label: 'Context', lines: [{ name: project.context }] },
  { label: 'Details', lines: details },
  { label: 'Recognition', lines: prizes },
  { label: 'Year', lines: [{ name: project.year ? String(project.year) : null }] },
] as Fact[]).map((fact) => ({ ...fact, lines: fact.lines.filter((line) => line.name) })).filter((fact) => fact.lines.length);
// The gallery tiles' aspect ratio; "natural" leaves every picture uncropped
const framingClass = { wide: 'is--wide', square: 'is--square', tall: 'is--tall', natural: undefined };
---
<BaseLayout title={`${project.title} — Tomrowstudios`} namespace={`project-${project.slug}`} pageName={project.name ?? ''} navTitle={project.title ?? project.name ?? 'Architecture'} navSection="/architecture" mainClass="is--bare">
<SiteNav />


<!-- Project header: the project's cover in a band across the top of the
     screen, edge to edge, under the bar; under it, on the black, the title large on the
     left, flush on the studio's name in the bar above, and from the bar's
     pages' line on the right the project's facts, a ruled row each, with
     the standfirst under them. No column lines and no grain on these pages
     (is--bare). -->
<header class="shop-hero is--project">
  {project.coverImage && (
  <div class="project-hero__bg" data-project-bg aria-hidden="true">
    <img {...imageAttrs(project.coverImage, 1600)} alt="" decoding="async" data-reveal-wait class="project-hero__bg-img">
    <span class="project-hero__shade"></span>
  </div>
  )}
  <div class="shop-hero__body project-hero__body">
    <div class="shop-hero__copy">
      <h1>{project.title}</h1>
    </div>
    <div class="project-hero__meta">
      {facts.length ? (
      <dl class="project-facts">
        {facts.map(({ label, lines }) => (
        <div class="project-facts__row">
          <dt>{label}</dt>
          <dd>{lines.map(({ name, note }) => <span class="project-facts__line">{name}{note && <span class="project-facts__note"> · {note}</span>}</span>)}</dd>
        </div>
        ))}
      </dl>
      ) : null}
      {project.lead && <p class="project-hero__lead">{project.lead}</p>}
    </div>
  </div>
</header>

{project.content?.map((section) => (
<>
{/* Full bleed */}
{section._type === 'featureImage' && (
<section class="project-bleed">
  <img data-click-zoom data-cursor-label="Enlarge" {...imageAttrs(section)} loading="lazy" decoding="async" alt={section.alt ?? ''}>
</section>
)}
{/* Image band, one picture to a column of the grid (or two across, for
    pairs). A plain grid: every frame's size is known before its picture
    arrives, so nothing moves while they load. */}
{section._type === 'imageGallery' && (
<section class:list={['project-grid', { 'is--pairs': section.layout === 'pairs' }]}>
  <div class="project-grid__list">
    {section.images?.map((image) => (
    <div data-click-zoom data-cursor-label="Enlarge" class:list={['project-grid__item', framingClass[section.framing ?? 'wide']]}>
      <img {...imageAttrs(image)} loading="lazy" decoding="async" alt={image.alt ?? ''}>
    </div>
    ))}
  </div>
</section>
)}
{/* Overview */}
{section._type === 'textSection' && (
<section class="project-note">
  <div class="project-note__inner">
    {section.label && <p class="tagline">{section.label}</p>}
    <div class="project-note__body">
        {section.body && <PortableText value={section.body} />}
    </div>
  </div>
</section>
)}
</>
))}

<!-- Keep scrolling past the end of the project and the ring fills; when it
     closes, the link is taken and the next project loads. -->
{next && (
<section data-scroll-next-wrap data-scroll-start="top top" data-scroll-end="bottom bottom" class="scroll-next">
  <a data-scroll-next-link href={`/projects/${next.slug}`} class="scroll-next__inner">
    <div class="scroll-next__bg">
      {next.coverImage && <img {...imageAttrs(next.coverImage)} data-scroll-next-bg alt="" class="scroll-next__bg-img">}
      <div data-scroll-next-overlay class="scroll-next__bg-overlay"></div>
    </div>
    <div class="scroll-next__center">
      <span class="scroll-next__sub">Next project</span>
      <h2 class="scroll-next__h">{next.name}</h2>
    </div>
    <div class="scroll-next__progres">
      <svg xmlns="http://www.w3.org/2000/svg" width="100%" viewBox="0 0 480 480" fill="none" class="scroll-next__progres-svg"><circle opacity="0.4" cx="240" cy="240" r="240" stroke="currentColor" stroke-width="3"></circle><circle opacity="1" cx="240" cy="240" r="240" stroke="currentColor" stroke-width="3" data-scroll-next-path></circle></svg>
    </div>
  </a>
</section>
)}

<ContactPanel />
</BaseLayout>
