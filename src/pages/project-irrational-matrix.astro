---
import BaseLayout from '../layouts/BaseLayout.astro';
import SiteNav from '../components/SiteNav.astro';
import ContactPanel from '../components/ContactPanel.astro';
import Button from '../components/Button.astro';
---
<BaseLayout title="Irrational Matrix — Tomrow Studios" namespace="project-matrix" pageName="Irrational Matrix">
<SiteNav />


<!-- Project header. The title takes the top of the page on its own; the rule
     under it separates the standfirst from the awards, so the two read as a
     row rather than one long pile of stacked blocks. -->
<header class="project-hero">
  <p class="tagline project-hero__eyebrow">Architecture — Dissertation</p>
  <h1 class="project-hero__title">Irrational Matrix</h1>
  <div class="project-hero__meta">
    <p class="project-hero__lead">Using Daniel Libeskind to question the role of drawing in architectural representation.</p>
    <div class="project-hero__side">
    <ul class="award-labels">
      <li class="award-label is--meta"><span class="award-label__name">Dissertation</span></li>
      <li class="award-label is--meta"><span class="award-label__name">Daniel Libeskind: Chamber Works and Micromegas</span></li>
      <li class="award-label is--meta"><span class="award-label__name">University of Westminster</span></li>
    </ul>
      <div class="actions project-hero__actions">
        <Button href="https://www.tomrowstudios.com/_files/ugd/746e36_cd0befd81e9548c89428def8600fde85.pdf" target="_blank" rel="noopener" label="Download Portfolio" />
        <Button href="architecture.html" label="All projects" secondary />
      </div>
    </div>
  </div>
</header>

<!-- Image band, on the four-column grid -->
<section class="project-grid">
  <div class="masonry-wrap">
    <div class="masonry-collection">
      <div data-masonry-list data-masonry-shuffle="false" class="masonry-list">
        <div class="masonry-item">
          <div data-click-zoom class="masonry-item__visual is--square">
            <img src="assets/projects/irrational-matrix/01.jpg" width="1600" height="1600" loading="lazy" decoding="async" alt="Irrational Matrix — plate 1" class="masonry-item__visual-img">
          </div>
        </div>
        <div class="masonry-item">
          <div data-click-zoom class="masonry-item__visual is--square">
            <img src="assets/projects/irrational-matrix/02.jpg" width="1600" height="1599" loading="lazy" decoding="async" alt="Irrational Matrix — plate 2" class="masonry-item__visual-img">
          </div>
        </div>
        <div class="masonry-item">
          <div data-click-zoom class="masonry-item__visual is--square">
            <img src="assets/projects/irrational-matrix/03.jpg" width="1600" height="1600" loading="lazy" decoding="async" alt="Irrational Matrix — plate 3" class="masonry-item__visual-img">
          </div>
        </div>
        <div class="masonry-item">
          <div data-click-zoom class="masonry-item__visual is--square">
            <img src="assets/projects/irrational-matrix/04.jpg" width="1066" height="1599" loading="lazy" decoding="async" alt="Irrational Matrix — plate 4" class="masonry-item__visual-img">
          </div>
        </div>
        <div class="masonry-item">
          <div data-click-zoom class="masonry-item__visual is--square">
            <img src="assets/projects/irrational-matrix/05.jpg" width="1600" height="1600" loading="lazy" decoding="async" alt="Irrational Matrix — plate 5" class="masonry-item__visual-img">
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- Overview -->
<section class="project-note">
  <div class="project-note__inner">
    <p class="tagline">The project</p>
    <div class="project-note__body">
        <p>In my dissertation, I aim to study both Chamber Works and Micromegas as drawings that push the role of representation in architectural drawing. These drawings have sparked intriguing discussions amongst commentators due to how they oppose the conventions of an architectural drawing of the time.</p>
        <p>While Chamber Works provides an overarching narrative regarding the connection between architecture and music, Micromegas explore fluctuating form and space. By referring to the descriptions and analogies made by Libeskind and by making an account of some of the more significant critics to have commented on his work, I aim to dissect the drawing works that made him a leading avant-garde figure in architecture.</p>
    </div>
  </div>
</section>

<!-- Portfolio download -->
<section class="project-close">
  <div class="actions">
    <Button href="https://www.tomrowstudios.com/_files/ugd/746e36_cd0befd81e9548c89428def8600fde85.pdf" target="_blank" rel="noopener" label="Download Portfolio" />
  </div>
</section>

<!-- Keep scrolling past the end of the project and the ring fills; when it
     closes, the link is taken and the next project loads. -->
<section data-scroll-next-wrap data-scroll-start="top top" data-scroll-end="bottom bottom" class="scroll-next">
  <a data-scroll-next-link href="project-the-sequel.html" class="scroll-next__inner">
    <div class="scroll-next__bg">
      <img src="assets/projects/the-sequel/01.jpg" width="1600" height="451" data-scroll-next-bg alt="" class="scroll-next__bg-img">
      <div data-scroll-next-overlay class="scroll-next__bg-overlay"></div>
    </div>
    <div class="scroll-next__center">
      <span class="scroll-next__sub">Next project</span>
      <h2 class="scroll-next__h">The Sequel</h2>
    </div>
    <div class="scroll-next__progres">
      <svg xmlns="http://www.w3.org/2000/svg" width="100%" viewbox="0 0 480 480" fill="none" class="scroll-next__progres-svg"><circle opacity="0.4" cx="240" cy="240" r="240" stroke="currentColor" stroke-width="3"></circle><circle opacity="1" cx="240" cy="240" r="240" stroke="currentColor" stroke-width="3" data-scroll-next-path></circle></svg>
    </div>
  </a>
</section>

<ContactPanel />
</BaseLayout>
