---
import BaseLayout from '../layouts/BaseLayout.astro';
import SiteNav from '../components/SiteNav.astro';
import ContactPanel from '../components/ContactPanel.astro';
import Button from '../components/Button.astro';
---
<BaseLayout title="The Sequel — Tomrow Studios" namespace="project-sequel" pageName="The Sequel">
<SiteNav />


<!-- Project header. The title takes the top of the page on its own; the rule
     under it separates the standfirst from the awards, so the two read as a
     row rather than one long pile of stacked blocks. -->
<header class="project-hero">
  <p class="tagline project-hero__eyebrow">Architecture — Digbeth, Birmingham — 2020</p>
  <h1 class="project-hero__title">The Sequel</h1>
  <div class="project-hero__meta">
    <p class="project-hero__lead">Fields of movement exploration, in response to the social challenge and stigma towards ex-convicts.</p>
    <div class="project-hero__side">
    <ul class="award-labels">
      <li class="award-label"><span class="award-label__name">RIBA Bronze Medal</span><span class="award-label__note">Nominated 2020</span></li>
      <li class="award-label"><span class="award-label__name">AJ Student Prize Award</span><span class="award-label__note">Nominated 2020</span></li>
      <li class="award-label is--meta"><span class="award-label__name">Digbeth, Birmingham</span></li>
      <li class="award-label is--meta"><span class="award-label__name">University of Westminster</span></li>
      <li class="award-label is--meta"><span class="award-label__name">2020</span></li>
    </ul>
      <div class="actions project-hero__actions">
        <Button href="https://www.tomrowstudios.com/_files/ugd/746e36_5721c37a4e36477a96ba406cb3069aed.pdf" target="_blank" rel="noopener" label="Download Portfolio" />
        <Button href="architecture.html" label="All projects" secondary />
      </div>
    </div>
  </div>
</header>

<!-- Full bleed -->
<section class="project-bleed">
  <img data-click-zoom src="assets/projects/the-sequel/01.jpg" width="1600" height="451" loading="lazy" decoding="async" alt="The Sequel — plate 1">
</section>

<!-- Image band, on the four-column grid -->
<section class="project-grid">
  <div class="masonry-wrap">
    <div class="masonry-collection">
      <div data-masonry-list data-masonry-shuffle="false" class="masonry-list">
        <div class="masonry-item">
          <div data-click-zoom class="masonry-item__visual is--wide">
            <img src="assets/projects/the-sequel/02.jpg" width="1600" height="914" loading="lazy" decoding="async" alt="The Sequel — plate 2" class="masonry-item__visual-img">
          </div>
        </div>
        <div class="masonry-item">
          <div data-click-zoom class="masonry-item__visual is--wide">
            <img src="assets/projects/the-sequel/03.jpg" width="1600" height="914" loading="lazy" decoding="async" alt="The Sequel — plate 3" class="masonry-item__visual-img">
          </div>
        </div>
        <div class="masonry-item">
          <div data-click-zoom class="masonry-item__visual is--wide">
            <img src="assets/projects/the-sequel/04.jpg" width="1600" height="914" loading="lazy" decoding="async" alt="The Sequel — plate 4" class="masonry-item__visual-img">
          </div>
        </div>
        <div class="masonry-item">
          <div data-click-zoom class="masonry-item__visual is--wide">
            <img src="assets/projects/the-sequel/05.jpg" width="1600" height="914" loading="lazy" decoding="async" alt="The Sequel — plate 5" class="masonry-item__visual-img">
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- Full bleed -->
<section class="project-bleed">
  <img data-click-zoom src="assets/projects/the-sequel/06.jpg" width="1600" height="914" loading="lazy" decoding="async" alt="The Sequel — plate 6">
</section>

<!-- Overview -->
<section class="project-note">
  <div class="project-note__inner">
    <p class="tagline">The project</p>
    <div class="project-note__body">
        <p>The two-part series begins with the Sequence, which explores and analyses movement in Digbeth, Birmingham, and continues research in film theory by monitoring speed, direction and time through film and key-framing.</p>
        <p>The Sequel resolves fields of movement exploration in response to the social challenge and stigma towards ex-convicts. A metaphorical timeline anchors the construct in forming a monument that tells the story of the ex-convict in their first 12 months of rehabilitation.</p>
        <p>The building utilises my exploration to create a journey that widens, narrows, diverts, meanders, opens, and closes. An intricate sequence and module formation create slits that portray the contrast between light and dark, with concrete acting as a canvas to add to the internal experience.</p>
    </div>
  </div>
</section>

<!-- Image band, on the four-column grid -->
<section class="project-grid is--pairs">
  <div class="masonry-wrap">
    <div class="masonry-collection">
      <div data-masonry-list data-masonry-shuffle="false" class="masonry-list">
        <div class="masonry-item">
          <div data-click-zoom class="masonry-item__visual is--wide">
            <img src="assets/projects/the-sequel/07.jpg" width="1600" height="914" loading="lazy" decoding="async" alt="The Sequel — plate 7" class="masonry-item__visual-img">
          </div>
        </div>
        <div class="masonry-item">
          <div data-click-zoom class="masonry-item__visual is--wide">
            <img src="assets/projects/the-sequel/08.jpg" width="1600" height="914" loading="lazy" decoding="async" alt="The Sequel — plate 8" class="masonry-item__visual-img">
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- Portfolio download -->
<section class="project-close">
  <div class="actions">
    <Button href="https://www.tomrowstudios.com/_files/ugd/746e36_5721c37a4e36477a96ba406cb3069aed.pdf" target="_blank" rel="noopener" label="Download Portfolio" />
  </div>
</section>

<!-- Keep scrolling past the end of the project and the ring fills; when it
     closes, the link is taken and the next project loads. -->
<section data-scroll-next-wrap data-scroll-start="top top" data-scroll-end="bottom bottom" class="scroll-next">
  <a data-scroll-next-link href="project-the-sequel-post.html" class="scroll-next__inner">
    <div class="scroll-next__bg">
      <img src="assets/projects/the-sequel-post/01.jpg" width="1600" height="450" data-scroll-next-bg alt="" class="scroll-next__bg-img">
      <div data-scroll-next-overlay class="scroll-next__bg-overlay"></div>
    </div>
    <div class="scroll-next__center">
      <span class="scroll-next__sub">Next project</span>
      <h2 class="scroll-next__h">The Sequel: Post-production</h2>
    </div>
    <div class="scroll-next__progres">
      <svg xmlns="http://www.w3.org/2000/svg" width="100%" viewbox="0 0 480 480" fill="none" class="scroll-next__progres-svg"><circle opacity="0.4" cx="240" cy="240" r="240" stroke="currentColor" stroke-width="3"></circle><circle opacity="1" cx="240" cy="240" r="240" stroke="currentColor" stroke-width="3" data-scroll-next-path></circle></svg>
    </div>
  </a>
</section>

<ContactPanel />
</BaseLayout>
