---
import BaseLayout from '../layouts/BaseLayout.astro';
import SiteNav from '../components/SiteNav.astro';
import SiteFooter from '../components/SiteFooter.astro';
import ContactPanel from '../components/ContactPanel.astro';
import ServiceCards from '../components/ServiceCards.astro';
import CaseStudyPanel from '../components/CaseStudyPanel.astro';
import { imageAttrs } from '../sanity/image';
import { PARTNERS_PAGE_QUERY, PARTNERS_QUERY } from '../sanity/queries';
import { PAGE_DEFAULTS } from '../sanity/page-defaults';
import type { PARTNERS_QUERY_RESULT } from '../sanity/sanity.types';

// The page's words, from the Partners page document's archive section (or
// the page's defaults), and the partners: the grid and the drawers it opens
const [page, allPartners] = await Promise.all([
  Astro.locals.sanity.fetch(PARTNERS_PAGE_QUERY),
  Astro.locals.sanity.fetch(PARTNERS_QUERY),
]);
const D = PAGE_DEFAULTS.partnersPage;
// The partners the page can show: those with a cover image
type Partner = PARTNERS_QUERY_RESULT[number];
type Shown = Partner & { coverImage: NonNullable<Partner['coverImage']> };
const partners = allPartners.filter((partner): partner is Shown => Boolean(partner.coverImage?.asset));
// A partner with a case study to open: one with a title
const hasCaseStudy = (partner: Partner) => Boolean(partner.caseStudy?.title);
---
<BaseLayout title="Archive — Tomrowstudios" namespace="partners-archive" pageName="Archive" pageDoc="partnersPage" navSection="/partner">
<!-- The page itself, which shrinks into the footer as the footer arrives (footer.js) -->
<div class="page-surface" data-page-surface>
<SiteNav />

<div class="theme-light">

<section class="section">
  <div class="container">
    <div class="section-head">
      <div class="section-head__main">
        <p class="tagline label-pill">Archive</p>
        <h2 class="page-hero-title" data-page-field="archive.heading">{page?.archive?.heading ?? D.archive.heading}</h2>
      </div>
      <div class="section-head__side">
        <p class="lead" data-page-field="archive.lead">{page?.archive?.lead ?? D.archive.lead}</p>
      </div>
    </div>

    <!-- One partner to a column, each with its number and name under it -->
    <div class="archive-grid">
      {partners.map((partner, i) => {
        const inner = <>
          <span class="archive-card__media"><img {...imageAttrs(partner.coverImage, 1200)} alt={partner.coverImage.alt ?? `Case study — ${partner.name}`} loading="lazy" decoding="async"></span>
          <span class="archive-card__label"><span class="archive-card__index">{String(i + 1).padStart(2, '0')}</span><span class="archive-card__name">{partner.name}</span></span>
        </>;
        return hasCaseStudy(partner) ? (
          <a class="archive-card" href={`#case-${partner.slug}`} data-case-open={`case-${partner.slug}`} data-barba-prevent="self" data-cursor-label="View Case Study">{inner}</a>
        ) : (
          <div class="archive-card">{inner}</div>
        );
      })}
    </div>
  </div>
</section>

</div>

<ServiceCards />


</div>

<SiteFooter />

<!-- Case study side panels (slide-out drawers), one per partner with a case study -->
{partners.filter(hasCaseStudy).map((partner) => <CaseStudyPanel partner={partner} />)}

<ContactPanel />
</BaseLayout>
