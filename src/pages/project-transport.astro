---
import BaseLayout from '../layouts/BaseLayout.astro';
import SiteNav from '../components/SiteNav.astro';
import ContactPanel from '../components/ContactPanel.astro';
import Button from '../components/Button.astro';
---
<BaseLayout title="Trans[port]: Logistics Market — Tomrow Studios" namespace="project-transport" pageName="Trans[port]">
<SiteNav />


<!-- Project header. The title takes the top of the page on its own; the rule
     under it separates the standfirst from the awards, so the two read as a
     row rather than one long pile of stacked blocks. -->
<header class="project-hero">
  <p class="tagline project-hero__eyebrow">Architecture — MArch 2 — 2023</p>
  <h1 class="project-hero__title">Trans[port]: Logistics Market</h1>
  <div class="project-hero__meta">
    <p class="project-hero__lead">A hybrid design project that collides warehouse logic with retail markets and goods consumption.</p>
    <div class="project-hero__side">
    <ul class="award-labels">
      <li class="award-label"><span class="award-label__name">The Shoaib Rawat Memorial Prize</span><span class="award-label__note">Nominated 2023</span></li>
      <li class="award-label is--meta"><span class="award-label__name">MArch 2</span></li>
      <li class="award-label is--meta"><span class="award-label__name">University of Westminster</span></li>
      <li class="award-label is--meta"><span class="award-label__name">2023</span></li>
    </ul>
      <div class="actions project-hero__actions">
        <Button href="https://www.tomrowstudios.com/_files/ugd/746e36_a60b395b644c4660b17bc8aa0f1df0e6.pdf" target="_blank" rel="noopener" label="Download Portfolio" />
        <Button href="architecture.html" label="All projects" secondary />
      </div>
    </div>
  </div>
</header>

<!-- Full bleed -->
<section class="project-bleed">
  <img data-click-zoom src="assets/projects/transport/01.jpg" width="1600" height="902" loading="lazy" decoding="async" alt="Trans[port]: Logistics Market — plate 1">
</section>

<!-- Image band, on the four-column grid -->
<section class="project-grid">
  <div class="masonry-wrap">
    <div class="masonry-collection">
      <div data-masonry-list data-masonry-shuffle="false" class="masonry-list">
        <div class="masonry-item">
          <div data-click-zoom class="masonry-item__visual is--wide">
            <img src="assets/projects/transport/02.jpg" width="1600" height="902" loading="lazy" decoding="async" alt="Trans[port]: Logistics Market — plate 2" class="masonry-item__visual-img">
          </div>
        </div>
        <div class="masonry-item">
          <div data-click-zoom class="masonry-item__visual is--wide">
            <img src="assets/projects/transport/03.jpg" width="1600" height="902" loading="lazy" decoding="async" alt="Trans[port]: Logistics Market — plate 3" class="masonry-item__visual-img">
          </div>
        </div>
        <div class="masonry-item">
          <div data-click-zoom class="masonry-item__visual is--wide">
            <img src="assets/projects/transport/04.jpg" width="1600" height="902" loading="lazy" decoding="async" alt="Trans[port]: Logistics Market — plate 4" class="masonry-item__visual-img">
