---
import BaseLayout from '../layouts/BaseLayout.astro';
import SiteNav from '../components/SiteNav.astro';
import SiteFooter from '../components/SiteFooter.astro';
import ContactPanel from '../components/ContactPanel.astro';
import Button from '../components/Button.astro';
import GetInTouch from '../components/GetInTouch.astro';
---
<BaseLayout title="Shop — Tomrow Studios" namespace="shop" pageName="Shop">
<SiteNav />

<!-- Hero -->
<header class="shop-hero">
  <div class="shop-hero__body">
    <div class="shop-hero__copy">
      <p class="tagline">Shop</p>
      <h1>Tools for a clearer Practice</h1>
      <p class="lead">Courses, books and resources built for working architects — the methods behind the drawings, the writing and the presentations.</p>
      <div class="social-proof">
        <div class="social-proof__avatars">
          <img src="/assets/photos/portraits/portrait-02.jpg" alt="">
          <img src="/assets/photos/portraits/portrait-06.jpg" alt="">
          <img src="/assets/photos/portraits/portrait-09.jpg" alt="">
          <img src="/assets/photos/portraits/portrait-11.jpg" alt="">
        </div>
        <div class="social-proof__body">
          <img class="social-proof__stars" src="/assets/ui/stars.svg" alt="Rated five out of five">
          <p class="social-proof__label">Join over <strong>12,000</strong> architects</p>
        </div>
      </div>
      <div class="actions">
        <Button href="#catalogue" data-barba-prevent="self" label="Browse the shop" />
        <Button href="/book" label="Read the book" secondary />
      </div>
    </div>
    <div class="shop-hero__media">
      <img src="/assets/photos/studio/studio-05.jpg" alt="">
    </div>
  </div>
</header>

<!-- Products -->
<section class="section section-alt" id="catalogue">
  <div class="container">
    <div class="section-title section-title-left">
      <p class="tagline">Catalogue</p>
      <h2>Everything in the shop</h2>
    </div>

    <div class="product-grid">
      <article class="product-card">
        <img class="product-img" src="/assets/photos/thumbnails/thumb-08.jpg" alt="">
        <div class="product-body">
          <div class="product-info">
            <span class="tag tag-dark">Course</span>
            <span class="product-meta">Self-paced</span>
          </div>
          <h5>Architectural presentation masterclass</h5>
          <p>A direct method for producing drawings and presentations that communicate clearly</p>
          <Button href="/product" label="View Course" />
        </div>
      </article>

      <article class="product-card">
        <img class="product-img" src="/assets/photos/thumbnails/thumb-09.jpg" alt="">
        <div class="product-body">
          <div class="product-info">
            <span class="tag tag-dark">Package</span>
            <span class="product-meta">Digital download</span>
          </div>
          <h5>Architecture communication package</h5>
          <p>Templates, guides, and frameworks for writing about and presenting architectural work</p>
          <Button href="/course-communication" label="View Course" />
        </div>
      </article>

      <article class="product-card">
        <img class="product-img" src="/assets/photos/lifestyle/lifestyle-10.jpg" alt="">
        <div class="product-body">
          <div class="product-info">
            <span class="tag tag-dark">Book</span>
            <span class="product-meta">Hardcover</span>
          </div>
          <h5>Architectural Influence</h5>
          <p>A precedent analysis of the 21 creators shaping how architecture is seen, shared and understood online</p>
          <Button href="/book" label="Buy the Book" />
        </div>
      </article>

      <article class="product-card">
        <img class="product-img" src="/assets/photos/products/sketchbook.jpg" width="1600" height="1600" loading="lazy" decoding="async" alt="An Architect's Digital Sketchbook with Morpholio Trace">
        <div class="product-body">
          <div class="product-info">
            <span class="tag tag-dark">Guide</span>
            <span class="product-meta">Free PDF</span>
          </div>
          <h5>An Architect's Digital Sketchbook</h5>
          <p>A step-by-step guide to sketching in Morpholio Trace — layering, photomontage and portfolio-ready output, with Hamza Shaikh</p>
          <Button href="/course-sketchbook" label="View Guide" />
        </div>
      </article>
    </div>
  </div>
</section>

<!-- Testimonials -->
<section class="section section-alt">
  <div class="container">
    <div class="section-title">
      <h2>What students say</h2>
      <p class="lead">Architects and designers on how the courses changed their work</p>
    </div>

    <div data-slider-autoplay-duration="4" aria-label="Testimonial Slider" data-centered-slider="wrapper" data-slider-autoplay="true" class="centered-slider-group">
      <div class="container">
        <div class="centered-slider-content">
          <ul role="tablist" class="centered-slider-bullet__list">
            <li class="centered-slider-bullet__item"><button data-centered-slider="bullet" role="tab" aria-selected="false" class="centered-slider-bullet"><img src="/assets/photos/portraits/portrait-02.jpg" alt="Lena Müller"></button></li>
            <li class="centered-slider-bullet__item"><button data-centered-slider="bullet" role="tab" aria-selected="false" class="centered-slider-bullet"><img src="/assets/photos/portraits/portrait-03.jpg" alt="James Okonkwo"></button></li>
            <li class="centered-slider-bullet__item"><button data-centered-slider="bullet" role="tab" aria-selected="false" class="centered-slider-bullet"><img src="/assets/photos/portraits/portrait-06.jpg" alt="Sofia Reyes"></button></li>
            <li class="centered-slider-bullet__item"><button data-centered-slider="bullet" role="tab" aria-selected="false" class="centered-slider-bullet"><img src="/assets/photos/portraits/portrait-08.jpg" alt="Elena Kowalski"></button></li>
            <li class="centered-slider-bullet__item"><button data-centered-slider="bullet" role="tab" aria-selected="false" class="centered-slider-bullet"><img src="/assets/photos/portraits/portrait-09.jpg" alt="Daniel Chen"></button></li>
            <li class="centered-slider-bullet__item"><button data-centered-slider="bullet" role="tab" aria-selected="false" class="centered-slider-bullet"><img src="/assets/photos/portraits/portrait-10.jpg" alt="Amara Okafor"></button></li>
            <li class="centered-slider-bullet__item"><button data-centered-slider="bullet" role="tab" aria-selected="false" class="centered-slider-bullet"><img src="/assets/photos/portraits/portrait-11.jpg" alt="Clara Johansson"></button></li>
            <li class="centered-slider-bullet__item"><button data-centered-slider="bullet" role="tab" aria-selected="false" class="centered-slider-bullet"><img src="/assets/photos/portraits/portrait-07.jpg" alt="Omar Farouk"></button></li>
          </ul>
        </div>
      </div>
      <div class="centered-slider-row">
        <div aria-label="slides" data-centered-slider="list" role="group" class="centered-slider-list">
          <div data-centered-slider="slide" class="centered-slider-slide">
            <div class="centered-slider-slide__inner">
              <p class="slide-demo__description">"The presentation course cut through everything I was overcomplicating. My drawings are cleaner now, and I spend far less time second-guessing what belongs on a sheet."</p>
              <div class="slide-demo__details"><img src="/assets/photos/portraits/portrait-02.jpg" alt="" class="slide-demo__avatar"><span class="slide-demo__eyebrow">Lena Müller</span></div>
            </div>
          </div>
          <div data-centered-slider="slide" class="centered-slider-slide">
            <div class="centered-slider-slide__inner">
              <p class="slide-demo__description">"I stopped writing project descriptions that nobody read. The communication package gave me a structure I use every week."</p>
              <div class="slide-demo__details"><img src="/assets/photos/portraits/portrait-03.jpg" alt="" class="slide-demo__avatar"><span class="slide-demo__eyebrow">James Okonkwo</span></div>
            </div>
          </div>
          <div data-centered-slider="slide" class="centered-slider-slide">
            <div class="centered-slider-slide__inner">
              <p class="slide-demo__description">"The book changed how I talk about my work in crits. Less explaining, more showing. My tutors noticed within a fortnight."</p>
              <div class="slide-demo__details"><img src="/assets/photos/portraits/portrait-06.jpg" alt="" class="slide-demo__avatar"><span class="slide-demo__eyebrow">Sofia Reyes</span></div>
            </div>
          </div>
          <div data-centered-slider="slide" class="centered-slider-slide">
            <div class="centered-slider-slide__inner">
              <p class="slide-demo__description">"Worth it for the module on handling critique alone. I walked into my next review knowing which questions were coming and what I actually thought."</p>
              <div class="slide-demo__details"><img src="/assets/photos/portraits/portrait-08.jpg" alt="" class="slide-demo__avatar"><span class="slide-demo__eyebrow">Elena Kowalski</span></div>
            </div>
          </div>
          <div data-centered-slider="slide" class="centered-slider-slide">
            <div class="centered-slider-slide__inner">
              <p class="slide-demo__description">"Practical rather than theoretical. Every session ends with something you can apply to the sheet you are already working on."</p>
              <div class="slide-demo__details"><img src="/assets/photos/portraits/portrait-09.jpg" alt="" class="slide-demo__avatar"><span class="slide-demo__eyebrow">Daniel Chen</span></div>
            </div>
          </div>
          <div data-centered-slider="slide" class="centered-slider-slide">
            <div class="centered-slider-slide__inner">
              <p class="slide-demo__description">"My final review panel said it was the clearest presentation they had seen all day. That came directly from this approach."</p>
              <div class="slide-demo__details"><img src="/assets/photos/portraits/portrait-10.jpg" alt="" class="slide-demo__avatar"><span class="slide-demo__eyebrow">Amara Okafor</span></div>
            </div>
          </div>
          <div data-centered-slider="slide" class="centered-slider-slide">
            <div class="centered-slider-slide__inner">
              <p class="slide-demo__description">"The frameworks are simple, but they force you to be honest about what your project is actually doing. That is the hard part."</p>
              <div class="slide-demo__details"><img src="/assets/photos/portraits/portrait-11.jpg" alt="" class="slide-demo__avatar"><span class="slide-demo__eyebrow">Clara Johansson</span></div>
            </div>
          </div>
          <div data-centered-slider="slide" class="centered-slider-slide">
            <div class="centered-slider-slide__inner">
              <p class="slide-demo__description">"It helped me move from describing my project to defending it. Those are two different skills and nobody had told me that."</p>
              <div class="slide-demo__details"><img src="/assets/photos/portraits/portrait-07.jpg" alt="" class="slide-demo__avatar"><span class="slide-demo__eyebrow">Omar Farouk</span></div>
            </div>
          </div>
        </div>
      </div>
      <div class="container">
        <div class="centered-slider-content">
          <div class="centered-slider-buttons">
            <button aria-label="previous slide" data-centered-slider="prev-button" class="centered-slider-button is--prev">
              <svg xmlns="http://www.w3.org/2000/svg" width="100%" viewbox="0 0 24 24" fill="none" class="slider-button-arrow">
                <path d="M14 19L21 12L14 5" stroke="currentColor" stroke-miterlimit="10"></path>
                <path d="M21 12H2" stroke="currentColor" stroke-miterlimit="10"></path>
              </svg>
            </button>
            <button aria-label="next slide" data-centered-slider="next-button" class="centered-slider-button"><svg xmlns="http://www.w3.org/2000/svg" width="100%" viewbox="0 0 24 24" fill="none" class="slider-button-arrow">
                <path d="M14 19L21 12L14 5" stroke="currentColor" stroke-miterlimit="10"></path>
                <path d="M21 12H2" stroke="currentColor" stroke-miterlimit="10"></path>
              </svg>
            </button>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- FAQ -->
<section class="section section-alt">
  <div class="container">
    <div class="faq-layout">
      <div class="faq-layout__head">
        <p class="tagline">Support</p>
        <h2>FAQ</h2>
        <p class="faq-layout__note">Everything you need to know about access, delivery and support.</p>
      </div>

      <div class="faq">
      <details open>
        <summary>How do I access my purchase?</summary>
        <p>Once you've completed your purchase, you'll receive an email with a direct link to your course or digital product. Access is immediate and remains available indefinitely. You can log in anytime to download files or revisit materials.</p>
      </details>
      <details>
        <summary>Can I download the files?</summary>
        <p>Yes. All digital products and course materials are available for download. You own what you purchase and can store files locally or in your preferred cloud service.</p>
      </details>
      <details>
        <summary>What if I need a refund?</summary>
        <p>We offer a 14-day money-back guarantee if you're not satisfied. Contact us with your order details and we'll process it promptly. No questions asked.</p>
      </details>
      <details>
        <summary>Are there group discounts?</summary>
        <p>For teams or studios purchasing multiple licenses, we offer custom pricing. Reach out through the Partners page to discuss your needs and we'll find a solution.</p>
      </details>
      <details>
        <summary>Do you offer certificates?</summary>
        <p>Course completions come with a digital certificate of achievement. This is yours to share, print, or add to your professional profile as you see fit.</p>
      </details>

        <div class="faq-footer">
          <h3>Need more help?</h3>
          <p class="lead">Get in touch directly for anything not covered here</p>
          <Button href="#contact" data-panel-open="contact" data-barba-prevent="self" label="Contact" />
        </div>
      </div>
    </div>
  </div>
</section>

<GetInTouch />


<SiteFooter />

<ContactPanel />
</BaseLayout>
