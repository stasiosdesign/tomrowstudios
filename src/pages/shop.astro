---
import BaseLayout from '../layouts/BaseLayout.astro';
import SiteNav from '../components/SiteNav.astro';
import SiteFooter from '../components/SiteFooter.astro';
import ContactPanel from '../components/ContactPanel.astro';
import Arrow from '../components/Arrow.astro';
import Button from '../components/Button.astro';
import ServiceCards from '../components/ServiceCards.astro';
import ProductCard from '../components/ProductCard.astro';
import { SHOP_ITEMS_QUERY, SHOP_PAGE_QUERY } from '../sanity/queries';
import { FAQ_DEFAULTS, PAGE_DEFAULTS } from '../sanity/page-defaults';

// The page's words, from the Shop page document (or the page's defaults),
// the FAQ's questions from the same document (or the five it was built
// with), and the products from the shop items, in their order; the quotes
// stay here. The questions carry their keys (data-page-item) so the
// Studio's Visual editor can redraw the list as it is edited
// (src/sanity/live-preview.ts).
const [page, items] = await Promise.all([
  Astro.locals.sanity.fetch(SHOP_PAGE_QUERY),
  Astro.locals.sanity.fetch(SHOP_ITEMS_QUERY),
]);
const D = PAGE_DEFAULTS.shopPage;
const questions = page?.faq?.questions?.length ? page.faq.questions : FAQ_DEFAULTS;
// The quotes: real five-star reviews of Tom's courses, in the reviewers'
// own words (their spelling and grammar kept). A long review is cut to an
// excerpt of about the others' length, each cut marked [...], nothing
// added; a short one is left whole and set a size larger (is--short)
// rather than lengthened. Each reviewer by their initials, not a picture.
// One more review, whose name is cut off in the source, waits for its
// name: "Just finished your course mate, well worth it! Architects tend to
// love to gatekeep their design process and it was really insightful and
// proper helpful as I go into third year. Cheers."
const reviews = [
  { name: 'Mattia Amato', quote: 'The course shows the work and method of a truly prepared guy. I was able to see [...] the difference in approach to the graphic construction of the architectural project.' },
  { name: 'Dan May', quote: 'The course was amazing! It’s really changed how I present my work and the process I design in order to present. My tutors have already commented on the difference [...]' },
  { name: 'Bashayer Abduallah', quote: 'I finished two modules but so far it’s been good can’t wait to start the others modules.' },
  { name: 'Ferrin', quote: 'In the architectural graphic design course, I gained valuable experiences that have influenced my understanding of the field. [...] Overall, the course equipped me with practical skills [...]' },
  { name: 'Alex Bndv', quote: 'Really interesting, fun way of learning!' },
];
const initials = (name: string) => name.split(/\s+/).map((part) => part[0]).join('').slice(0, 2).toUpperCase();
---
<BaseLayout title="Shop — Tomrowstudios" namespace="shop" pageName="Shop" pageDoc="shopPage">
<!-- The page itself, which shrinks into the footer as the footer arrives
     (footer.js); no column lines on this page, the grain kept (is--gridless) -->
<div class="page-surface is--gridless" data-page-surface>
<SiteNav />

<!-- The hero, laid out as the other pages' (.shop-hero): the page's name
     large on the black, flush left on the studio's name in the bar above,
     and under it what the shop holds, set as the Influence and Partners
     pages' descriptions are -->
<header class="shop-hero is--shop">
  <div class="shop-hero__body">
    <div class="shop-hero__copy">
      <h1 data-page-field="hero.heading">{page?.hero?.heading ?? D.hero.heading}</h1>
      <p class="shop-hero__about">Tom’s book, courses and downloadable guides for architects and students: practical methods for drawing, presenting and writing about your work.</p>
    </div>
  </div>
</header>

<!-- Products: one card to a column -->
<section class="section section-alt" id="catalogue">
  <div class="container">
    <div class="section-head">
      <div class="section-head__main">
        <p class="tagline label-pill" data-page-field="catalogue.label">{page?.catalogue?.label ?? D.catalogue.label}</p>
        <h2 data-page-field="catalogue.heading">{page?.catalogue?.heading ?? D.catalogue.heading}</h2>
      </div>
      <!-- The shop's description, moved here from the hero -->
      <div class="section-head__side">
        <p class="lead" data-page-field="hero.lead">{page?.hero?.lead ?? D.hero.lead}</p>
      </div>
    </div>

    <div class="product-grid">
      {items.map((item, i) => <ProductCard item={item} index={i + 1} />)}
    </div>
  </div>
</section>

<!-- Testimonials -->
<section class="section section-alt">
  <div class="container">
    <div class="section-head">
      <div class="section-head__main">
        <p class="tagline label-pill">Testimonials</p>
        <h2 data-page-field="testimonials.heading">{page?.testimonials?.heading ?? D.testimonials.heading}</h2>
      </div>
      <div class="section-head__side">
        <p class="lead" data-page-field="testimonials.lead">{page?.testimonials?.lead ?? D.testimonials.lead}</p>
      </div>
    </div>

    <div data-slider-autoplay-duration="6" aria-label="Testimonial Slider" data-centered-slider="wrapper" data-slider-autoplay="true" class="centered-slider-group">
      <div class="container">
        <div class="centered-slider-content">
          <ul role="tablist" class="centered-slider-bullet__list">
            {reviews.map(({ name }) => (
            <li class="centered-slider-bullet__item"><button data-centered-slider="bullet" role="tab" aria-selected="false" aria-label={name} class="centered-slider-bullet"><span class="slide-demo__initials" aria-hidden="true">{initials(name)}</span></button></li>
            ))}
          </ul>
        </div>
      </div>
      <div class="centered-slider-row">
        <div aria-label="slides" data-centered-slider="list" role="group" class="centered-slider-list">
          {reviews.map(({ name, quote }) => (
          <div data-centered-slider="slide" class="centered-slider-slide">
            <div class="centered-slider-slide__inner">
              <div class="slide-demo__quote">
                <img class="slide-demo__stars" src="/assets/ui/stars.svg" alt="Rated five out of five stars" width="116" height="19">
                <p class:list={['slide-demo__description', { 'is--short': quote.length < 100 }]}>"{quote}"</p>
              </div>
              <div class="slide-demo__details"><span class="slide-demo__avatar slide-demo__initials" aria-hidden="true">{initials(name)}</span><span class="slide-demo__eyebrow">{name}</span></div>
              <span class="centered-slider-progress" aria-hidden="true"><span class="centered-slider-progress__bar" data-centered-slider="progress"></span></span>
            </div>
          </div>
          ))}
        </div>
      </div>
      <div class="container">
        <div class="centered-slider-content">
          <div class="centered-slider-buttons">
            <button aria-label="previous slide" data-centered-slider="prev-button" class="centered-slider-button is--prev">
              <Arrow class="slider-button-arrow" />
            </button>
            <button aria-label="next slide" data-centered-slider="next-button" class="centered-slider-button"><Arrow class="slider-button-arrow" />
            </button>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- FAQ -->
<section class="section section-alt">
  <div class="container">
    <div class="faq-layout">
      <div class="faq-layout__head">
        <p class="tagline" data-page-field="faq.label">{page?.faq?.label ?? D.faq.label}</p>
        <h2 data-page-field="faq.heading">{page?.faq?.heading ?? D.faq.heading}</h2>
        <p class="faq-layout__note" data-page-field="faq.note">{page?.faq?.note ?? D.faq.note}</p>
      </div>

      <div class="faq" data-page-list="faq.questions">
      {questions.map((item, i) => (
        <details open={i === 0} data-page-item={item._key}>
          <summary data-page-item-field="question">{item.question}</summary>
          <p data-page-item-field="answer">{item.answer}</p>
        </details>
      ))}

        <div class="faq-footer">
          <h3 data-page-field="faq.helpHeading">{page?.faq?.helpHeading ?? D.faq.helpHeading}</h3>
          <p class="lead" data-page-field="faq.helpLead">{page?.faq?.helpLead ?? D.faq.helpLead}</p>
          <Button href="#contact" data-panel-open="contact" data-barba-prevent="self" data-page-field="faq.helpButton" label={page?.faq?.helpButton ?? D.faq.helpButton} />
        </div>
      </div>
    </div>
  </div>
</section>

<ServiceCards />


</div>

<SiteFooter />

<ContactPanel />
</BaseLayout>
