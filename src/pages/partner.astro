---
import BaseLayout from '../layouts/BaseLayout.astro';
import SiteNav from '../components/SiteNav.astro';
import SiteFooter from '../components/SiteFooter.astro';
import ContactPanel from '../components/ContactPanel.astro';
import Button from '../components/Button.astro';
import GetInTouch from '../components/GetInTouch.astro';
import { imageAttrs, type SanityImage } from '../sanity/image';
import { PARTNERS_PAGE_QUERY } from '../sanity/queries';
import { contentParams } from '../sanity/content';
import { PAGE_DEFAULTS, type ImageDefault } from '../sanity/page-defaults';

// The page's words and portrait, from the Partners page document (or the
// page's defaults); the case studies, the logos, the services, the
// testimonials, the results and the form stay here
const page = await Astro.locals.sanity.fetch(PARTNERS_PAGE_QUERY, contentParams);
const D = PAGE_DEFAULTS.partnersPage;
// An <img>'s src, size and alt: the photo set in the Studio, or the page's own file
const img = (image: SanityImage | null | undefined, fallback: ImageDefault, width: number) =>
  image?.asset ? { ...imageAttrs(image, width), alt: image.alt ?? fallback.alt } : { src: fallback.path, width: fallback.width, height: fallback.height, alt: fallback.alt };
---
<BaseLayout title="Partners — Tomrow Studios" namespace="partner" pageName="Partners" pageDoc="partnersPage">
<SiteNav />

<div class="theme-light">

<!-- Intro gallery -->
<section class="section">
  <div class="container">
    <div class="section-title section-title-left">
      <h2 class="page-hero-title" data-page-field="intro.heading">{page?.intro?.heading ?? D.intro.heading}</h2>
      <p class="lead" data-page-field="intro.lead">{page?.intro?.lead ?? D.intro.lead}</p>
      <div class="actions">
        <Button href="#contact" data-panel-open="contact" data-barba-prevent="self" data-page-field="intro.button" label={page?.intro?.button ?? D.intro.button} />
      </div>
    </div>
    <div data-swiper-group class="swiper-group">
      <div data-swiper-wrap class="swiper">
        <div class="swiper-wrapper">
          <div class="swiper-slide">
            <a class="slide-card" href="#case-rayon" data-panel-open="case-rayon" data-barba-prevent="self">
              <img src="/assets/photos/talks/talk-13.jpg" draggable="false" alt="Case study — Intel">
              <span class="slide-card__index">01</span>
              <span class="slide-card__name">Intel</span>
            </a>
          </div>
          <div class="swiper-slide">
            <a class="slide-card" href="#case-rayon" data-panel-open="case-rayon" data-barba-prevent="self">
              <img src="/assets/photos/talks/talk-14.jpg" draggable="false" alt="Case study — Epic Games">
              <span class="slide-card__index">02</span>
              <span class="slide-card__name">Epic Games</span>
            </a>
          </div>
          <div class="swiper-slide">
            <a class="slide-card" href="#case-rayon" data-panel-open="case-rayon" data-barba-prevent="self">
              <img src="/assets/photos/talks/talk-15.jpg" draggable="false" alt="Case study — Speckle">
              <span class="slide-card__index">03</span>
              <span class="slide-card__name">Speckle</span>
            </a>
          </div>
          <div class="swiper-slide">
            <a class="slide-card" href="#case-rayon" data-panel-open="case-rayon" data-barba-prevent="self">
              <img src="/assets/photos/talks/talk-17.jpg" draggable="false" alt="Case study — D5 Render">
              <span class="slide-card__index">04</span>
              <span class="slide-card__name">D5 Render</span>
            </a>
          </div>
          <div class="swiper-slide">
            <a class="slide-card" href="#case-rayon" data-panel-open="case-rayon" data-barba-prevent="self">
              <img src="/assets/photos/talks/talk-16.jpg" draggable="false" alt="Case study — Gendo">
              <span class="slide-card__index">05</span>
              <span class="slide-card__name">Gendo</span>
            </a>
          </div>
          <div class="swiper-slide">
            <a class="slide-card" href="#case-rayon" data-panel-open="case-rayon" data-barba-prevent="self">
              <img src="/assets/photos/events/event-09.jpg" draggable="false" alt="Case study — Material Bank">
              <span class="slide-card__index">06</span>
              <span class="slide-card__name">Material Bank</span>
            </a>
          </div>
          <div class="swiper-slide">
            <a class="slide-card" href="#case-rayon" data-panel-open="case-rayon" data-barba-prevent="self">
              <img src="/assets/photos/events/event-10.jpg" draggable="false" alt="Case study — Qonic">
              <span class="slide-card__index">07</span>
              <span class="slide-card__name">Qonic</span>
            </a>
          </div>
          <div class="swiper-slide">
            <a class="slide-card" href="#case-rayon" data-panel-open="case-rayon" data-barba-prevent="self">
              <img src="/assets/photos/events/event-11.jpg" draggable="false" alt="Case study — Motif">
              <span class="slide-card__index">08</span>
              <span class="slide-card__name">Motif</span>
            </a>
          </div>
          <div class="swiper-slide">
            <a class="slide-card" href="#case-rayon" data-panel-open="case-rayon" data-barba-prevent="self">
              <img src="/assets/photos/events/event-12.jpg" draggable="false" alt="Case study — Giraffe">
              <span class="slide-card__index">09</span>
              <span class="slide-card__name">Giraffe</span>
            </a>
          </div>
          <div class="swiper-slide">
            <a class="slide-card" href="#case-rayon" data-panel-open="case-rayon" data-barba-prevent="self">
              <img src="/assets/photos/studio/studio-03.jpg" draggable="false" alt="Case study — Finch">
              <span class="slide-card__index">10</span>
              <span class="slide-card__name">Finch</span>
            </a>
          </div>
          <div class="swiper-slide">
            <a class="slide-card" href="#case-rayon" data-panel-open="case-rayon" data-barba-prevent="self">
              <img src="/assets/photos/talks/talk-18.jpg" draggable="false" alt="Case study — Krea">
              <span class="slide-card__index">11</span>
              <span class="slide-card__name">Krea</span>
            </a>
          </div>
          <div class="swiper-slide">
            <a class="slide-card" href="#case-rayon" data-panel-open="case-rayon" data-barba-prevent="self">
              <img src="/assets/photos/events/event-13.jpg" draggable="false" alt="Case study — Architypes">
              <span class="slide-card__index">12</span>
              <span class="slide-card__name">Architypes</span>
            </a>
          </div>
        </div>
      </div>
      <div class="swiper-navigation">
        <button data-swiper-prev class="swiper-navigation__button">
          <svg xmlns="http://www.w3.org/2000/svg" width="100%" viewBox="0 0 24 24" fill="none" class="swiper-navigation__button-arorw is--prev"><path d="M14 19L21 12L14 5" stroke="currentColor" stroke-miterlimit="10" stroke-width="2"></path><path d="M21 12H2" stroke="currentColor" stroke-miterlimit="10" stroke-width="2"></path></svg>
        </button>
        <div class="swiper-pagination"></div>
        <button data-swiper-next class="swiper-navigation__button">
          <svg xmlns="http://www.w3.org/2000/svg" width="100%" viewBox="0 0 24 24" fill="none" class="swiper-navigation__button-arorw"><path d="M14 19L21 12L14 5" stroke="currentColor" stroke-miterlimit="10" stroke-width="2"></path><path d="M21 12H2" stroke="currentColor" stroke-miterlimit="10" stroke-width="2"></path></svg>
        </button>
      </div>
    </div>
  </div>
</section>

<!-- Logo strip -->
<section class="section logo-strip">
  <div class="section-title section-title-left logo-strip__head">
    <p class="tagline" data-page-field="clients.label">{page?.clients?.label ?? D.clients.label}</p>
    <h2 class="logo-strip-title" data-page-field="clients.heading">{page?.clients?.heading ?? D.clients.heading}</h2>
    <p class="logo-strip__note" data-page-field="clients.note">{page?.clients?.note ?? D.clients.note}</p>
  </div>
</section>

<section class="logo-marquee is--tight">
  <div data-marquee-duplicate="2" data-marquee-scroll-direction-target data-marquee-direction="right" data-marquee-status="normal" data-marquee-speed="15" data-marquee-scroll-speed="10" class="marquee-advanced">
    <div data-marquee-scroll-target class="marquee-advanced__scroll">
      <div data-marquee-collection-target class="marquee-advanced__collection">
        <!-- Placeholder strip: the two supplied marks alternating. An even
             count so the pair still alternates across the loop seam. Swap these
             rows for the real set when the rest of the logos arrive. -->
        <div class="marquee-advanced__item-width"><img src="/assets/logos/finch-logo.png" loading="lazy" alt="Finch"></div>
        <div class="marquee-advanced__item-width"><img src="/assets/logos/Gendo-Logo-White.png" loading="lazy" alt="Gendo"></div>
        <div class="marquee-advanced__item-width"><img src="/assets/logos/finch-logo.png" loading="lazy" alt="Finch"></div>
        <div class="marquee-advanced__item-width"><img src="/assets/logos/Gendo-Logo-White.png" loading="lazy" alt="Gendo"></div>
        <div class="marquee-advanced__item-width"><img src="/assets/logos/finch-logo.png" loading="lazy" alt="Finch"></div>
        <div class="marquee-advanced__item-width"><img src="/assets/logos/Gendo-Logo-White.png" loading="lazy" alt="Gendo"></div>
        <div class="marquee-advanced__item-width"><img src="/assets/logos/finch-logo.png" loading="lazy" alt="Finch"></div>
        <div class="marquee-advanced__item-width"><img src="/assets/logos/Gendo-Logo-White.png" loading="lazy" alt="Gendo"></div>
        <div class="marquee-advanced__item-width"><img src="/assets/logos/finch-logo.png" loading="lazy" alt="Finch"></div>
        <div class="marquee-advanced__item-width"><img src="/assets/logos/Gendo-Logo-White.png" loading="lazy" alt="Gendo"></div>
        <div class="marquee-advanced__item-width"><img src="/assets/logos/finch-logo.png" loading="lazy" alt="Finch"></div>
        <div class="marquee-advanced__item-width"><img src="/assets/logos/Gendo-Logo-White.png" loading="lazy" alt="Gendo"></div>
      </div>
    </div>
  </div>
</section>


<!-- Statement — the headline takes the top of the grid on its own, then a
     portrait in the first column against the copy in the last two. -->
<section class="section statement">
  <div class="container">
    <h2 class="statement__title"><span data-page-field="statement.heading">{page?.statement?.heading ?? D.statement.heading}</span><span class="statement__dot" aria-hidden="true"></span></h2>
    <div class="statement__row">
      <div class="statement__media">
        <img data-page-field="statement.image" data-page-width="1200" {...img(page?.statement?.image, D.statement.image, 1200)} loading="lazy" decoding="async">
      </div>
      <div class="statement__body">
        <p class="statement__lead" data-page-field="statement.lead">{page?.statement?.lead ?? D.statement.lead}</p>
        <div class="actions">
          <Button href="/partners-archive" data-page-field="statement.button" label={page?.statement?.button ?? D.statement.button} />
        </div>
      </div>
    </div>
  </div>
</section>
<!-- Services -->
<section class="section service-section">
  <div class="container">
    <div data-service-list class="service-list">
      <div class="service-list__aside">
        <div class="service-list__intro">
          <p class="tagline" data-page-field="services.label">{page?.services?.label ?? D.services.label}</p>
          <p class="service-list__lead" data-page-field="services.lead">{page?.services?.lead ?? D.services.lead}</p>
        </div>
      </div>
      <ul class="service-list__items">
        <li data-service-item data-service-desc="Defining the ideas, messaging and content a brand needs to position itself clearly." class="service-list__item">Content Strategy</li>
        <li data-service-item data-service-desc="Building a visual direction that gives campaigns and products a distinctive identity." class="service-list__item">Photography</li>
        <li data-service-item data-service-desc="Shooting and cutting films that carry the idea, not just the footage." class="service-list__item">Video</li>
        <li data-service-item data-service-desc="Showing an audience what a tool actually does, in the language they already use." class="service-list__item">Product</li>
        <li data-service-item data-service-desc="Planning a launch end to end, from the first teaser to the last follow-up." class="service-list__item">Campaigns</li>
        <li data-service-item data-service-desc="Teaching teams and students how to present architectural work convincingly." class="service-list__item">Workshops</li>
        <li data-service-item data-service-desc="Setting the creative standard a project is held to, and holding it there." class="service-list__item">Direction</li>
        <li data-service-item data-service-desc="Reading a channel honestly and saying what to keep, what to cut and what to change." class="service-list__item">Consulting</li>
        <li data-service-item data-service-desc="Writing the words that go with the work, from launch copy to long-form editorial." class="service-list__item">Editorial</li>
        <li data-service-item data-service-desc="Speaking at conferences, schools and industry events on architecture and audience." class="service-list__item">Talks</li>
        <li data-service-item data-service-desc="Bringing the right architects and studios into a project, and briefing them properly." class="service-list__item">Partnerships</li>
        <li data-service-item data-service-desc="Turning what a channel did into something a team can actually act on next quarter." class="service-list__item">Reporting</li>
      </ul>
      <!-- Third column: the line changes with whichever deliverable is lit -->
      <div class="service-list__detail">
        <p data-service-detail class="service-list__detail-text">Defining the ideas, messaging and content a brand needs to position itself clearly.</p>
      </div>
    </div>
  </div>
</section>

<!-- Testimonial -->
<section class="testimonial-feature">
  <div data-testimonial class="testimonial-stage">
    <div data-testimonial-slide class="testimonial-slide is--active" aria-hidden="false">
      <img class="testimonial-slide__bg" src="/assets/photos/portraits/portrait-07.jpg" alt="">
      <div class="testimonial-slide__body">
        <blockquote>"Tom didn't just understand the brief. He understood the audience we were trying to reach before we did."</blockquote>
        <p class="testimonial-slide__who"><span>Oliver Thomas</span> Head of content, Archi-Tech Network</p>
      </div>
    </div>
    <div data-testimonial-slide class="testimonial-slide" aria-hidden="true">
      <img class="testimonial-slide__bg" src="/assets/photos/events/event-06.jpg" alt="">
      <div class="testimonial-slide__body">
        <blockquote>"We had the footage and none of the story. He found the through-line in an afternoon and we have used it ever since."</blockquote>
        <p class="testimonial-slide__who"><span>Marta Alvarez</span> Marketing lead, Rayon Design</p>
      </div>
    </div>
    <div data-testimonial-slide class="testimonial-slide" aria-hidden="true">
      <img class="testimonial-slide__bg" src="/assets/photos/talks/talk-09.jpg" alt="">
      <div class="testimonial-slide__body">
        <blockquote>"He speaks to architects as an architect. That is the whole reason the campaign landed the way it did."</blockquote>
        <p class="testimonial-slide__who"><span>Daniel Osei</span> Director, Studio North</p>
      </div>
    </div>
    <div data-testimonial-slide class="testimonial-slide" aria-hidden="true">
      <img class="testimonial-slide__bg" src="/assets/photos/events/event-08.jpg" alt="">
      <div class="testimonial-slide__body">
        <blockquote>"Booked him for one keynote and came away with a content plan for the year. Rare to get both from the same person."</blockquote>
        <p class="testimonial-slide__who"><span>Priya Raman</span> Programme lead, RIBA</p>
      </div>
    </div>

    <div role="tablist" aria-label="Choose a testimonial" class="testimonial-chips">
      <button data-testimonial-chip role="tab" aria-selected="true" class="testimonial-chip is--active">
        <img src="/assets/photos/portraits/portrait-03.jpg" alt="">
        <span class="testimonial-chip__text"><span class="testimonial-chip__name">Oliver Thomas</span><span class="testimonial-chip__role">Archi-Tech Network</span></span>
      </button>
      <button data-testimonial-chip role="tab" aria-selected="false" class="testimonial-chip">
        <img src="/assets/photos/portraits/portrait-08.jpg" alt="">
        <span class="testimonial-chip__text"><span class="testimonial-chip__name">Marta Alvarez</span><span class="testimonial-chip__role">Rayon Design</span></span>
      </button>
      <button data-testimonial-chip role="tab" aria-selected="false" class="testimonial-chip">
        <img src="/assets/photos/portraits/portrait-10.jpg" alt="">
        <span class="testimonial-chip__text"><span class="testimonial-chip__name">Daniel Osei</span><span class="testimonial-chip__role">Studio North</span></span>
      </button>
      <button data-testimonial-chip role="tab" aria-selected="false" class="testimonial-chip">
        <img src="/assets/photos/portraits/portrait-07.jpg" alt="">
        <span class="testimonial-chip__text"><span class="testimonial-chip__name">Priya Raman</span><span class="testimonial-chip__role">RIBA</span></span>
      </button>
    </div>
  </div>
</section>

<!-- Results — what the work returned, not how it was made. The figures use the
     site's own odometer, so they count up on scroll like the ones on Influence. -->
<section class="section theme-light results-section">
  <div class="container">
    <div class="two-col two-col-flat">
      <div>
        <p class="tagline" data-page-field="results.label">{page?.results?.label ?? D.results.label}</p>
        <h2 data-page-field="results.heading">{page?.results?.heading ?? D.results.heading}</h2>
        <div class="actions">
          <Button href="#contact" data-panel-open="contact" data-barba-prevent="self" label="Get Started" />
          <Button href="/partners-archive" label="View Work" secondary />
        </div>
      </div>
      <div>
        <p class="results-note" data-page-field="results.note">{page?.results?.note ?? D.results.note}</p>
      </div>
    </div>
    <ul data-odometer-group data-odometer-stagger="0.1" class="results-grid">
      <li class="results-card">
        <div class="results-card__top">
          <span class="results-card__index">R.01</span>
          <span class="results-card__tag">Campaigns</span>
        </div>
        <div class="results-card__body">
          <p data-odometer-element data-odometer-duration="2" class="results-card__value">+42%</p>
          <p class="results-card__label">Increase in campaign engagement</p>
        </div>
        <div class="results-card__foot">
          <span>Across launch work</span>
        </div>
      </li>
      <li class="results-card">
        <div class="results-card__top">
          <span class="results-card__index">R.02</span>
          <span class="results-card__tag">Enquiries</span>
        </div>
        <div class="results-card__body">
          <p data-odometer-element data-odometer-duration="2" class="results-card__value">3.2&#215;</p>
          <p class="results-card__label">More qualified enquiries</p>
        </div>
        <div class="results-card__foot">
          <span>Inbound, year on year</span>
        </div>
      </li>
      <li class="results-card">
        <div class="results-card__top">
          <span class="results-card__index">R.03</span>
          <span class="results-card__tag">Audience</span>
        </div>
        <div class="results-card__body">
          <p data-odometer-element data-odometer-duration="2" class="results-card__value">+68%</p>
          <p class="results-card__label">Growth in organic audience reach</p>
        </div>
        <div class="results-card__foot">
          <span>Unpaid channels</span>
        </div>
      </li>
      <li class="results-card">
        <div class="results-card__top">
          <span class="results-card__index">R.04</span>
          <span class="results-card__tag">Conversion</span>
        </div>
        <div class="results-card__body">
          <p data-odometer-element data-odometer-duration="2" class="results-card__value">+31%</p>
          <p class="results-card__label">Increase in conversion</p>
        </div>
        <div class="results-card__foot">
          <span>Landing to enquiry</span>
        </div>
      </li>
    </ul>
  </div>
</section>

<!-- Enquiry form -->
<section class="section" id="enquire">
  <div class="container">
    <div class="contact-split">
      <div>
        <p class="tagline" data-page-field="enquire.label">{page?.enquire?.label ?? D.enquire.label}</p>
        <h2 data-page-field="enquire.heading">{page?.enquire?.heading ?? D.enquire.heading}</h2>
        <p class="lead" data-page-field="enquire.lead">{page?.enquire?.lead ?? D.enquire.lead}</p>
        <ul class="contact-details">
          <li><img src="/assets/ui/mail.svg" alt=""><a href="mailto:tom@tomrowstudios.com" data-scramble-hover="link">tom@tomrowstudios.com</a></li>
          <li><img src="/assets/ui/call.svg" alt=""><a href="tel:+61280000000" data-scramble-hover="link">+61 2 8000 0000</a></li>
        </ul>
      </div>

      <div data-form-validate class="form-group">
        <form class="form" action="#" method="post" name="partner-enquiry">
          <div class="form-field-row">
            <div data-validate class="form-field-group">
              <label for="first-name" class="form-label">First name <span class="form-required">*</span></label>
              <div class="form-field">
                <input class="form-input" id="first-name" name="first-name" type="text" placeholder="Tom" maxlength="256" min="2" required>
                <div class="form-field-icon is--success"><svg xmlns="http://www.w3.org/2000/svg" width="100%" viewBox="0 0 24 24" fill="none"><path d="M11.25 14.25L9 12" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"></path><path d="M15 10.5L11.25 14.25" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"></path><path d="M3 12C3 16.9706 7.02943 21 12 21C16.9706 21 21 16.9706 21 12C21 7.02943 16.9706 3 12 3C7.02943 3 3 7.02943 3 12Z" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round"></path></svg></div>
                <div class="form-field-icon is--error"><svg xmlns="http://www.w3.org/2000/svg" width="100%" viewBox="0 0 24 24" fill="none"><path opacity="0.1" d="M12 3C16.971 3 21 7.029 21 12C21 16.971 16.971 21 12 21C7.029 21 3 16.971 3 12C3 7.029 7.029 3 12 3Z" fill="currentColor" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"></path><path d="M12 3C16.971 3 21 7.029 21 12C21 16.971 16.971 21 12 21C7.029 21 3 16.971 3 12C3 7.029 7.029 3 12 3Z" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round"></path><path d="M12 12.5V7.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"></path><path d="M11.996 14.5C11.444 14.5 10.996 14.948 11 15.5C11 16.052 11.448 16.5 12 16.5C12.552 16.5 13 16.052 13 15.5C13 14.948 12.552 14.5 11.996 14.5Z" fill="currentColor"></path></svg></div>
              </div>
            </div>
            <div data-validate class="form-field-group">
              <label for="last-name" class="form-label">Last name <span class="form-required">*</span></label>
              <div class="form-field">
                <input class="form-input" id="last-name" name="last-name" type="text" placeholder="Rowntree" maxlength="256" min="2" required>
                <div class="form-field-icon is--success"><svg xmlns="http://www.w3.org/2000/svg" width="100%" viewBox="0 0 24 24" fill="none"><path d="M11.25 14.25L9 12" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"></path><path d="M15 10.5L11.25 14.25" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"></path><path d="M3 12C3 16.9706 7.02943 21 12 21C16.9706 21 21 16.9706 21 12C21 7.02943 16.9706 3 12 3C7.02943 3 3 7.02943 3 12Z" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round"></path></svg></div>
