---
import BaseLayout from '../layouts/BaseLayout.astro';
import SiteNav from '../components/SiteNav.astro';
import SiteFooter from '../components/SiteFooter.astro';
import ContactPanel from '../components/ContactPanel.astro';
import Arrow from '../components/Arrow.astro';
import ContactButton from '../components/ContactButton.astro';
import ServiceCards from '../components/ServiceCards.astro';
import LogoRow from '../components/LogoRow.astro';
import CaseStudyPanel from '../components/CaseStudyPanel.astro';
import { imageAttrs, urlFor, type SanityImage } from '../sanity/image';
import { PARTNERS_PAGE_QUERY, PARTNERS_QUERY } from '../sanity/queries';
import { PAGE_DEFAULTS, type ImageDefault } from '../sanity/page-defaults';
import { email } from '../components/site-links';
import { CONTACT_ENDPOINT } from '../components/contact';
import type { PARTNERS_QUERY_RESULT } from '../sanity/sanity.types';

// The page's words and portrait, from the Partners page document (or the
// page's defaults), and the partners: the case-study slider, the panels it
// opens (CaseStudyPanel.astro) and the logo row. The services, the testimonials, the results
// and the form stay here. The form sends as the contact panel's does: to
// the address in contact.ts, offering the site's email whenever it was not
// sent (formvalidation.js)
const [page, allPartners] = await Promise.all([
  Astro.locals.sanity.fetch(PARTNERS_PAGE_QUERY),
  Astro.locals.sanity.fetch(PARTNERS_QUERY),
]);
const D = PAGE_DEFAULTS.partnersPage;
// The partners the page can show: those with a cover image
type Partner = PARTNERS_QUERY_RESULT[number];
type Shown = Partner & { coverImage: NonNullable<Partner['coverImage']> };
const partners = allPartners.filter((partner): partner is Shown => Boolean(partner.coverImage?.asset));
// A partner with a case study to open: one with a title
const hasCaseStudy = (partner: Partner) => Boolean(partner.caseStudy?.title);
// The logos for the logo row (LogoRow.astro): the partners that have one,
// or, while none has, the two supplied marks
type Logo = { name: string; logo: NonNullable<Partner['logo']> };
const withLogo = partners.flatMap((partner): Logo[] => (partner.logo?.asset ? [{ name: partner.name ?? '', logo: partner.logo }] : []));
const partnerLogos = withLogo.length
  ? withLogo.map(({ name, logo }) => ({ src: urlFor(logo).ignoreImageParams().width(600).height(240).url(), alt: name }))
  : [{ src: '/assets/logos/finch-logo.png', alt: 'Finch' }, { src: '/assets/logos/Gendo-Logo-White.png', alt: 'Gendo' }];
// The hero's stagger (style.css, "The partners' stagger"): the partners
// dealt into four columns, the first two to the right-hand pair (which
// stand highest), the next to the left-hand pair, and round again, so the
// first cards meet the eye under the introduction and the rest run on down
const STAGGER_ORDER = [2, 3, 1, 0];
const staggerColumns: { partner: Shown; i: number }[][] = [[], [], [], []];
partners.forEach((partner, i) => staggerColumns[STAGGER_ORDER[i % 4]].push({ partner, i }));
// An <img>'s src, size and alt: the photo set in the Studio, or the page's own file
const img = (image: SanityImage | null | undefined, fallback: ImageDefault, width: number) =>
  image?.asset ? { ...imageAttrs(image, width), alt: image.alt ?? fallback.alt } : { src: fallback.path, width: fallback.width, height: fallback.height, alt: fallback.alt };
// What the work returned (the results' panels): the figure, what it measures
// and where
const results = [
  { figure: '+42%', label: 'Increase in campaign engagement', foot: 'Across launch work' },
  { figure: '3.2&#215;', label: 'More qualified enquiries', foot: 'Inbound, year on year' },
  { figure: '+68%', label: 'Growth in organic audience reach', foot: 'Unpaid channels' },
  { figure: '+31%', label: 'Increase in conversion', foot: 'Landing to enquiry' },
];
// What Tom does: each service and the line that explains it
const services = [
  { name: 'Content Strategy', text: 'Defining the ideas, messaging and content a brand needs to position itself clearly.' },
  { name: 'Photography', text: 'Building a visual direction that gives campaigns and products a distinctive identity.' },
  { name: 'Video', text: 'Shooting and cutting films that carry the idea, not just the footage.' },
  { name: 'Product', text: 'Showing an audience what a tool actually does, in the language they already use.' },
  { name: 'Campaigns', text: 'Planning a launch end to end, from the first teaser to the last follow-up.' },
  { name: 'Workshops', text: 'Teaching teams and students how to present architectural work convincingly.' },
  { name: 'Direction', text: 'Setting the creative standard a project is held to, and holding it there.' },
  { name: 'Consulting', text: 'Reading a channel honestly and saying what to keep, what to cut and what to change.' },
  { name: 'Editorial', text: 'Writing the words that go with the work, from launch copy to long-form editorial.' },
  { name: 'Talks', text: 'Speaking at conferences, schools and industry events on architecture and audience.' },
  { name: 'Partnerships', text: 'Bringing the right architects and studios into a project, and briefing them properly.' },
  { name: 'Reporting', text: 'Turning what a channel did into something a team can actually act on next quarter.' },
];
---
<BaseLayout title="Partners — Tomrowstudios" namespace="partner" pageName="Partners" pageDoc="partnersPage" navTitle="Partners">
<!-- The page itself, which shrinks into the footer as the footer arrives (footer.js) -->
<div class="page-surface" data-page-surface>
<SiteNav />

<!-- The hero, laid out as the Shop and Influence pages' (.shop-hero): the
     page's name large on the black, flush left on the studio's name in the
     bar above -->
<header class="shop-hero is--partner theme-light">
  <div class="shop-hero__body">
    <div class="shop-hero__copy">
      <h1 data-page-field="intro.heading">{page?.intro?.heading ?? D.intro.heading}</h1>
    </div>
  </div>
</header>

<div class="theme-light">

<!-- Intro gallery -->
<section class="section">
  <div class="container">
    <div class="section-head is--hero">
      <div class="section-head__main"></div>
      <div class="section-head__side">
        <p class="lead" data-page-field="intro.lead">{page?.intro?.lead ?? D.intro.lead}</p>
        <div class="actions">
          <ContactButton data-page-field="intro.button" label={page?.intro?.button ?? D.intro.button} />
        </div>
      </div>
    </div>
    <!-- The partners' portraits as an editorial stagger: four columns on
         the page's own, each a column of portrait cards set a little lower
         or higher than its neighbour (style.css, "The partners' stagger"),
         the first cards to the right, high, and the rest running on down
         the page; on a smaller screen two columns -->
    <div class="partner-stagger">
      {staggerColumns.map((column) => (
      <div class="partner-stagger__col">
        {column.map(({ partner, i }) => {
          const index = String(i + 1).padStart(2, '0');
          const picture = <img {...imageAttrs(partner.coverImage, 1200)} draggable="false" alt={partner.coverImage.alt ?? `Case study — ${partner.name}`} loading={i < 4 ? undefined : 'lazy'} decoding="async">;
          const details = <><span class="slide-card__index">{index}</span><span class="slide-card__name">{partner.name}</span></>;
          return hasCaseStudy(partner) ? (
            <a class="slide-card" href={`#case-${partner.slug}`} data-case-open={`case-${partner.slug}`} data-barba-prevent="self" data-cursor-label="View Case Study">{picture}{details}</a>
          ) : (
            <div class="slide-card">{picture}{details}</div>
          );
        })}
      </div>
      ))}
    </div>
  </div>
</section>

<!-- The partners' logos: the home page's logo row (LogoRow.astro), the
     logos running sideways on a loop over their ruler, on the same dark
     band, under the section's heading and its note -->
<section class="logo-wall is--partner">
  <LogoRow logos={partnerLogos}>
    <h2 class="logo-grid__lead" data-page-field="clients.heading">{page?.clients?.heading ?? D.clients.heading}</h2>
    <p class="logo-grid__note" data-page-field="clients.note">{page?.clients?.note ?? D.clients.note}</p>
  </LogoRow>
</section>

<!-- Statement — the headline takes the top of the grid on its own, then a
     portrait in the first column against the copy in the last two. -->
<section class="section statement">
  <div class="container">
    <h2 class="statement__title"><span data-page-field="statement.heading">{page?.statement?.heading ?? D.statement.heading}</span><span class="statement__dot" aria-hidden="true"></span></h2>
    <div class="statement__row">
      <div class="statement__media">
        <img data-page-field="statement.image" data-page-width="1200" {...img(page?.statement?.image, D.statement.image, 1200)} loading="lazy" decoding="async">
      </div>
      <div class="statement__body">
        <p class="statement__lead" data-page-field="statement.lead">{page?.statement?.lead ?? D.statement.lead}</p>
        <div class="actions">
          <ContactButton href="/partners-archive" data-page-field="statement.button" label={page?.statement?.button ?? D.statement.button} />
        </div>
      </div>
    </div>
  </div>
</section>
<!-- Services: the home page's clients treatment (a scroll list,
     scroll-list.js). The services in a column of display type; the one
     crossing the middle of the screen lights up and its line of description
     shows on the right, while the section's name on the left and that line
     hold on the middle of the screen. Each name also carries its line for
     screen readers, so the column of descriptions is decoration. -->
<section class="section service-section">
  <div class="container">
    <div class="scroll-list services" data-scroll-list>
      <div class="scroll-list__intro">
        <div class="scroll-list__stick">
          <div class="scroll-list__intro-inner">
            <p class="tagline label-pill" data-page-field="services.label">{page?.services?.label ?? D.services.label}</p>
            <p class="scroll-list__lead" data-page-field="services.lead">{page?.services?.lead ?? D.services.lead}</p>
          </div>
        </div>
      </div>
      <ul class="scroll-list__list" role="list">
        {services.map(({ name, text }, i) => (
        <li class:list={['scroll-list__item', { 'is--active': i === 0 }]} data-scroll-list-item data-cursor="hover">{name}<span class="visually-hidden">: {text}</span></li>
        ))}
      </ul>
      <div class="scroll-list__aside" aria-hidden="true">
        <div class="scroll-list__stick">
          <div class="scroll-list__frame">
            {services.map(({ text }, i) => (
            <p class:list={['scroll-list__panel', { 'is--active': i === 0 }]} data-scroll-list-panel={i}>{text}</p>
            ))}
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- Testimonial -->
<section class="testimonial-feature">
  <div data-testimonial class="testimonial-stage">
    <div data-testimonial-slide class="testimonial-slide is--active" aria-hidden="false">
      <img class="testimonial-slide__bg" src="/assets/photos/portraits/portrait-07.jpg" alt="">
      <div class="testimonial-slide__body">
        <blockquote>"Tom didn't just understand the brief. He understood the audience we were trying to reach before we did."</blockquote>
        <p class="testimonial-slide__who"><span>Oliver Thomas</span> Head of content, Archi-Tech Network</p>
      </div>
    </div>
    <div data-testimonial-slide class="testimonial-slide" aria-hidden="true">
      <img class="testimonial-slide__bg" src="/assets/photos/events/event-06.jpg" alt="">
      <div class="testimonial-slide__body">
        <blockquote>"We had the footage and none of the story. He found the through-line in an afternoon and we have used it ever since."</blockquote>
        <p class="testimonial-slide__who"><span>Marta Alvarez</span> Marketing lead, Rayon Design</p>
      </div>
    </div>
    <div data-testimonial-slide class="testimonial-slide" aria-hidden="true">
      <img class="testimonial-slide__bg" src="/assets/photos/talks/talk-09.jpg" alt="">
      <div class="testimonial-slide__body">
        <blockquote>"He speaks to architects as an architect. That is the whole reason the campaign landed the way it did."</blockquote>
        <p class="testimonial-slide__who"><span>Daniel Osei</span> Director, Studio North</p>
      </div>
    </div>
    <div data-testimonial-slide class="testimonial-slide" aria-hidden="true">
      <img class="testimonial-slide__bg" src="/assets/photos/events/event-08.jpg" alt="">
      <div class="testimonial-slide__body">
        <blockquote>"Booked him for one keynote and came away with a content plan for the year. Rare to get both from the same person."</blockquote>
        <p class="testimonial-slide__who"><span>Priya Raman</span> Programme lead, RIBA</p>
      </div>
    </div>

    <div role="tablist" aria-label="Choose a testimonial" class="testimonial-chips">
      <button data-testimonial-chip role="tab" aria-selected="true" class="testimonial-chip is--active">
        <img src="/assets/photos/portraits/portrait-03.jpg" alt="">
        <span class="testimonial-chip__text"><span class="testimonial-chip__name">Oliver Thomas</span><span class="testimonial-chip__role">Archi-Tech Network</span></span>
      </button>
      <button data-testimonial-chip role="tab" aria-selected="false" class="testimonial-chip">
        <img src="/assets/photos/portraits/portrait-08.jpg" alt="">
        <span class="testimonial-chip__text"><span class="testimonial-chip__name">Marta Alvarez</span><span class="testimonial-chip__role">Rayon Design</span></span>
      </button>
      <button data-testimonial-chip role="tab" aria-selected="false" class="testimonial-chip">
        <img src="/assets/photos/portraits/portrait-10.jpg" alt="">
        <span class="testimonial-chip__text"><span class="testimonial-chip__name">Daniel Osei</span><span class="testimonial-chip__role">Studio North</span></span>
      </button>
      <button data-testimonial-chip role="tab" aria-selected="false" class="testimonial-chip">
        <img src="/assets/photos/portraits/portrait-07.jpg" alt="">
        <span class="testimonial-chip__text"><span class="testimonial-chip__name">Priya Raman</span><span class="testimonial-chip__role">RIBA</span></span>
      </button>
    </div>
  </div>
</section>

<!-- Results — what the work returned, not how it was made: the Shop hero's
     column of panels (InfluenceStory.astro, style.css "The column of
     panels"), in white on this page's paper, one panel a result, the one
     on the screen's middle grown large as the page scrolls by and the next
     taking over (influence.js, initInfluenceStrip); each figure counts up
     with the site's odometer as its panel comes in. Beside them, held
     while they pass, the section's name, its note and its calls to action. -->
<section class="section theme-light results-section">
  <div class="container results-layout">
    <div class="results-layout__head">
      <p class="tagline label-pill" data-page-field="results.label">{page?.results?.label ?? D.results.label}</p>
      <h2 data-page-field="results.heading">{page?.results?.heading ?? D.results.heading}</h2>
      <p class="lead" data-page-field="results.note">{page?.results?.note ?? D.results.note}</p>
      <div class="actions">
        <ContactButton label="Get Started" />
        <ContactButton href="/partners-archive" label="View Work" secondary />
      </div>
    </div>
    <ul class="influence-strip is--results" data-influence-strip>
      {results.map(({ figure, label, foot }) => (
      <li class="influence-strip__item" data-strip-item data-odometer-group>
        <p class="influence-strip__label">{label}</p>
        <p class="influence-strip__figure" data-odometer-element data-odometer-duration="1.6" set:html={figure}></p>
        <p class="influence-strip__foot">{foot}</p>
      </li>
      ))}
    </ul>
  </div>
</section>

<!-- Enquiry form -->
<section class="section" id="enquire">
  <div class="container">
    <div class="contact-split">
      <div>
        <p class="tagline" data-page-field="enquire.label">{page?.enquire?.label ?? D.enquire.label}</p>
        <h2 data-page-field="enquire.heading">{page?.enquire?.heading ?? D.enquire.heading}</h2>
        <p class="lead" data-page-field="enquire.lead">{page?.enquire?.lead ?? D.enquire.lead}</p>
        <ul class="contact-details" data-dim-group>
          <li><img src="/assets/ui/mail.svg" alt=""><a href="mailto:tom@tomrowstudios.com" data-split-hover="link">tom@tomrowstudios.com</a></li>
          <li><img src="/assets/ui/call.svg" alt=""><a href="tel:+61280000000" data-split-hover="link">+61 2 8000 0000</a></li>
        </ul>
      </div>

      <div data-form-validate class="form-group">
        <form class="form" action={CONTACT_ENDPOINT || undefined} method="post" name="partner-enquiry" data-endpoint={CONTACT_ENDPOINT} data-email={email} data-subject="Partnership enquiry">
          <div class="form-field-row">
            <div data-validate class="form-field-group">
              <label for="first-name" class="form-label">First name <span class="form-required">*</span></label>
              <div class="form-field">
                <input class="form-input" id="first-name" name="first-name" type="text" placeholder="Your first name" maxlength="256" min="2" required>
                <div class="form-field-icon is--success"><svg xmlns="http://www.w3.org/2000/svg" width="100%" viewBox="0 0 24 24" fill="none"><path d="M11.25 14.25L9 12" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"></path><path d="M15 10.5L11.25 14.25" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"></path><path d="M3 12C3 16.9706 7.02943 21 12 21C16.9706 21 21 16.9706 21 12C21 7.02943 16.9706 3 12 3C7.02943 3 3 7.02943 3 12Z" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round"></path></svg></div>
                <div class="form-field-icon is--error"><svg xmlns="http://www.w3.org/2000/svg" width="100%" viewBox="0 0 24 24" fill="none"><path opacity="0.1" d="M12 3C16.971 3 21 7.029 21 12C21 16.971 16.971 21 12 21C7.029 21 3 16.971 3 12C3 7.029 7.029 3 12 3Z" fill="currentColor" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"></path><path d="M12 3C16.971 3 21 7.029 21 12C21 16.971 16.971 21 12 21C7.029 21 3 16.971 3 12C3 7.029 7.029 3 12 3Z" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round"></path><path d="M12 12.5V7.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"></path><path d="M11.996 14.5C11.444 14.5 10.996 14.948 11 15.5C11 16.052 11.448 16.5 12 16.5C12.552 16.5 13 16.052 13 15.5C13 14.948 12.552 14.5 11.996 14.5Z" fill="currentColor"></path></svg></div>
              </div>
            </div>
            <div data-validate class="form-field-group">
              <label for="last-name" class="form-label">Last name <span class="form-required">*</span></label>
              <div class="form-field">
                <input class="form-input" id="last-name" name="last-name" type="text" placeholder="Your last name" maxlength="256" min="2" required>
                <div class="form-field-icon is--success"><svg xmlns="http://www.w3.org/2000/svg" width="100%" viewBox="0 0 24 24" fill="none"><path d="M11.25 14.25L9 12" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"></path><path d="M15 10.5L11.25 14.25" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"></path><path d="M3 12C3 16.9706 7.02943 21 12 21C16.9706 21 21 16.9706 21 12C21 7.02943 16.9706 3 12 3C7.02943 3 3 7.02943 3 12Z" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round"></path></svg></div>
                <div class="form-field-icon is--error"><svg xmlns="http://www.w3.org/2000/svg" width="100%" viewBox="0 0 24 24" fill="none"><path opacity="0.1" d="M12 3C16.971 3 21 7.029 21 12C21 16.971 16.971 21 12 21C7.029 21 3 16.971 3 12C3 7.029 7.029 3 12 3Z" fill="currentColor" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"></path><path d="M12 3C16.971 3 21 7.029 21 12C21 16.971 16.971 21 12 21C7.029 21 3 16.971 3 12C3 7.029 7.029 3 12 3Z" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round"></path><path d="M12 12.5V7.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"></path><path d="M11.996 14.5C11.444 14.5 10.996 14.948 11 15.5C11 16.052 11.448 16.5 12 16.5C12.552 16.5 13 16.052 13 15.5C13 14.948 12.552 14.5 11.996 14.5Z" fill="currentColor"></path></svg></div>
              </div>
            </div>
          </div>
          <div class="form-field-row">
            <div data-validate class="form-field-group">
              <label for="email" class="form-label">Email address <span class="form-required">*</span></label>
              <div class="form-field">
                <input class="form-input" id="email" name="email" type="email" placeholder="Your email" maxlength="256" required>
                <div class="form-field-icon is--success"><svg xmlns="http://www.w3.org/2000/svg" width="100%" viewBox="0 0 24 24" fill="none"><path d="M11.25 14.25L9 12" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"></path><path d="M15 10.5L11.25 14.25" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"></path><path d="M3 12C3 16.9706 7.02943 21 12 21C16.9706 21 21 16.9706 21 12C21 7.02943 16.9706 3 12 3C7.02943 3 3 7.02943 3 12Z" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round"></path></svg></div>
                <div class="form-field-icon is--error"><svg xmlns="http://www.w3.org/2000/svg" width="100%" viewBox="0 0 24 24" fill="none"><path opacity="0.1" d="M12 3C16.971 3 21 7.029 21 12C21 16.971 16.971 21 12 21C7.029 21 3 16.971 3 12C3 7.029 7.029 3 12 3Z" fill="currentColor" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"></path><path d="M12 3C16.971 3 21 7.029 21 12C21 16.971 16.971 21 12 21C7.029 21 3 16.971 3 12C3 7.029 7.029 3 12 3Z" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round"></path><path d="M12 12.5V7.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"></path><path d="M11.996 14.5C11.444 14.5 10.996 14.948 11 15.5C11 16.052 11.448 16.5 12 16.5C12.552 16.5 13 16.052 13 15.5C13 14.948 12.552 14.5 11.996 14.5Z" fill="currentColor"></path></svg></div>
              </div>
            </div>
            <div data-validate class="form-field-group">
              <label for="phone" class="form-label">Phone</label>
              <div class="form-field">
                <input class="form-input" id="phone" name="phone" type="tel" placeholder="Optional" maxlength="256">
                <div class="form-field-icon is--success"><svg xmlns="http://www.w3.org/2000/svg" width="100%" viewBox="0 0 24 24" fill="none"><path d="M11.25 14.25L9 12" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"></path><path d="M15 10.5L11.25 14.25" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"></path><path d="M3 12C3 16.9706 7.02943 21 12 21C16.9706 21 21 16.9706 21 12C21 7.02943 16.9706 3 12 3C7.02943 3 3 7.02943 3 12Z" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round"></path></svg></div>
                <div class="form-field-icon is--error"><svg xmlns="http://www.w3.org/2000/svg" width="100%" viewBox="0 0 24 24" fill="none"><path opacity="0.1" d="M12 3C16.971 3 21 7.029 21 12C21 16.971 16.971 21 12 21C7.029 21 3 16.971 3 12C3 7.029 7.029 3 12 3Z" fill="currentColor" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"></path><path d="M12 3C16.971 3 21 7.029 21 12C21 16.971 16.971 21 12 21C7.029 21 3 16.971 3 12C3 7.029 7.029 3 12 3Z" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round"></path><path d="M12 12.5V7.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"></path><path d="M11.996 14.5C11.444 14.5 10.996 14.948 11 15.5C11 16.052 11.448 16.5 12 16.5C12.552 16.5 13 16.052 13 15.5C13 14.948 12.552 14.5 11.996 14.5Z" fill="currentColor"></path></svg></div>
              </div>
            </div>
          </div>

          <div class="form-field-group">
            <label for="project-type" class="form-label">Project type</label>
            <div class="form-field">
              <select class="form-input is--select" id="project-type" name="project-type">
                <option value="">Select one...</option>
                <option>Strategy</option>
                <option>Production</option>
                <option>Partnerships</option>
                <option>Speaking</option>
              </select>
            </div>
          </div>

          <fieldset class="form-field-group radios">
            <legend class="form-label">Your role</legend>
            <div class="radio-grid">
              <label><input type="radio" name="role" value="Director"> Director</label>
              <label><input type="radio" name="role" value="Marketing lead"> Marketing lead</label>
              <label><input type="radio" name="role" value="Practice manager"> Practice manager</label>
              <label><input type="radio" name="role" value="Architect"> Architect</label>
              <label><input type="radio" name="role" value="Designer"> Designer</label>
              <label><input type="radio" name="role" value="Other"> Other</label>
            </div>
          </fieldset>

          <div data-validate class="form-field-group">
            <label for="message" class="form-label">Message <span class="form-required">*</span></label>
            <div class="form-field">
              <textarea class="form-input is--textarea" id="message" name="message" placeholder="Project details, timeframe and budget range." maxlength="5000" min="10" required></textarea>
              <div class="form-field-icon is--success"><svg xmlns="http://www.w3.org/2000/svg" width="100%" viewBox="0 0 24 24" fill="none"><path d="M11.25 14.25L9 12" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"></path><path d="M15 10.5L11.25 14.25" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"></path><path d="M3 12C3 16.9706 7.02943 21 12 21C16.9706 21 21 16.9706 21 12C21 7.02943 16.9706 3 12 3C7.02943 3 3 7.02943 3 12Z" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round"></path></svg></div>
              <div class="form-field-icon is--error"><svg xmlns="http://www.w3.org/2000/svg" width="100%" viewBox="0 0 24 24" fill="none"><path opacity="0.1" d="M12 3C16.971 3 21 7.029 21 12C21 16.971 16.971 21 12 21C7.029 21 3 16.971 3 12C3 7.029 7.029 3 12 3Z" fill="currentColor" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"></path><path d="M12 3C16.971 3 21 7.029 21 12C21 16.971 16.971 21 12 21C7.029 21 3 16.971 3 12C3 7.029 7.029 3 12 3Z" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round"></path><path d="M12 12.5V7.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"></path><path d="M11.996 14.5C11.444 14.5 10.996 14.948 11 15.5C11 16.052 11.448 16.5 12 16.5C12.552 16.5 13 16.052 13 15.5C13 14.948 12.552 14.5 11.996 14.5Z" fill="currentColor"></path></svg></div>
            </div>
          </div>

          <label class="checkbox"><input type="checkbox" name="consent"> I agree to be contacted about this enquiry</label>

          <div class="form-field-group">
            <div class="form-divider"></div>
          </div>

          <div class="form-field-group">
            <div class="form-field">
              <div data-submit tabindex="0" role="button" data-split-hover="link" class="hero-nav__contact form-submit-btn"><span class="hero-nav__contact-label"><span data-cta-label data-split-hover="target">Send enquiry</span></span><span class="hero-nav__contact-square"><Arrow class="hero-nav__contact-arrow" shape="straight" /></span><input type="submit" data-wait="Please wait..." class="form-submit" value="Send enquiry"></div>
            </div>
          </div>
        </form>
        <div class="form-notifcation" data-form-success role="status" tabindex="-1">
          <div class="form-notification-bg"></div>
          <div class="form-notification-p">Thank you — your enquiry is in. Tom will be in touch shortly.</div>
          <div class="form-notification-icon"><svg xmlns="http://www.w3.org/2000/svg" width="100%" viewBox="0 0 24 24" fill="none"><path d="M11.25 14.25L9 12" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"></path><path d="M15 10.5L11.25 14.25" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"></path><path d="M3 12C3 16.9706 7.02943 21 12 21C16.9706 21 21 16.9706 21 12C21 7.02943 16.9706 3 12 3C7.02943 3 3 7.02943 3 12Z" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round"></path></svg></div>
        </div>
        <div class="form-notifcation is--error" data-form-error role="alert">
          <div class="form-notification-bg"></div>
          <div class="form-notification-p">Your enquiry was not sent. Please email it to <a href={`mailto:${email}`}>{email}</a>.</div>
          <div class="form-notification-icon"><svg xmlns="http://www.w3.org/2000/svg" width="100%" viewBox="0 0 24 24" fill="none"><path opacity="0.1" d="M12 3C16.971 3 21 7.029 21 12C21 16.971 16.971 21 12 21C7.029 21 3 16.971 3 12C3 7.029 7.029 3 12 3Z" fill="currentColor" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"></path><path d="M12 3C16.971 3 21 7.029 21 12C21 16.971 16.971 21 12 21C7.029 21 3 16.971 3 12C3 7.029 7.029 3 12 3Z" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round"></path><path d="M12 12.5V7.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"></path><path d="M11.996 14.5C11.444 14.5 10.996 14.948 11 15.5C11 16.052 11.448 16.5 12 16.5C12.552 16.5 13 16.052 13 15.5C13 14.948 12.552 14.5 11.996 14.5Z" fill="currentColor"></path></svg></div>
        </div>
      </div>
    </div>
  </div>
</section>

</div>

<ServiceCards />


</div>

<SiteFooter />

<!-- Case study panels, one per partner with a case study, each grown out of
     its card when pressed (casepanel.js) -->
{partners.filter(hasCaseStudy).map((partner) => <CaseStudyPanel partner={partner} />)}

<ContactPanel />
</BaseLayout>
