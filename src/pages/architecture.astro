---
import BaseLayout from '../layouts/BaseLayout.astro';
import SiteNav from '../components/SiteNav.astro';
import ContactPanel from '../components/ContactPanel.astro';
import { sanityClient } from '../sanity/client';
import { imageAttrs } from '../sanity/image';
import { PROJECT_INDEX_QUERY } from '../sanity/queries';

// The projects from Sanity, in the order set in the Studio
const projects = await sanityClient.fetch(PROJECT_INDEX_QUERY);
const pad = (n: number) => String(n).padStart(2, '0');
---
<BaseLayout title="Architecture — Tomrow Studios" namespace="architecture" pageName="Architecture" mainClass="arch-page">
<SiteNav />

<!-- One screen, moving sideways. The projects run off the right-hand edge and
     are reached by dragging, by the arrows, or by scrolling up and down —
     which the slider reads as left and right. -->
<section class="arch-stage">

  <div data-parallax-init class="parallax-slider__group arch-stage__group">

    <div class="arch-stage__head">
      <p class="tagline">Architecture</p>
      <p class="arch-stage__count"><strong data-parallax-counter>01</strong> / {pad(projects.length)}</p>
    </div>

    <div class="arch-stage__slider">
      <div class="parallax-slider__collection">
        <div data-parallax-slider data-parallax-infinite="false" data-parallax-snap="false" data-parallax-amount="10" data-parallax-lerp="0.2" class="parallax-slider__list">

          {projects.map((project, i) => (
          <div class="parallax-slider__item">
            <a href={`/projects/${project.slug}`} class="parallax-slider__item-link">
              <div class="parallax-slider__item-inner">
                <div data-parallax-inner class="parallax-slider__item-visual">
                  {project.coverImage && <img {...imageAttrs(project.coverImage)} draggable="false" alt={project.coverImage.alt || project.name || ''} class="parallax-slider__item-img">}
                </div>
              </div>
              <div class="parallax-slider__item-label">
                <div>
                  <p class="parallax-slider__item-name">{project.name}</p>
                  <p class="parallax-slider__item-meta">{[pad(i + 1), project.context, project.year].filter(Boolean).join(' — ')}</p>
                </div>
                <span class="parallax-slider__item-cta" aria-hidden="true"></span>
              </div>
            </a>
          </div>
          ))}

        </div>
      </div>
    </div>

    <div class="arch-stage__foot">
      <h1 class="arch-stage__title">Architecture</h1>
      <div class="arch-arrows">
        <button type="button" data-parallax-prev class="arch-arrow is--prev is--disabled" aria-label="Previous project"></button>
        <button type="button" data-parallax-next class="arch-arrow is--next" aria-label="Next project"></button>
      </div>
    </div>

    <!-- Progress through the horizontal run, pinned to the bottom edge -->
    <div data-parallax-progress-wrap class="progress-bar-wrap">
      <div data-parallax-progress class="progress-bar"></div>
    </div>

  </div>

</section>

<ContactPanel />
</BaseLayout>
