---
import BaseLayout from '../layouts/BaseLayout.astro';
import SiteNav from '../components/SiteNav.astro';
import Arrow from '../components/Arrow.astro';
import ContactPanel from '../components/ContactPanel.astro';
import { imageAttrs } from '../sanity/image';
import { ARCHITECTURE_PAGE_QUERY, PROJECT_INDEX_QUERY } from '../sanity/queries';
import { PAGE_DEFAULTS } from '../sanity/page-defaults';

// The projects from Sanity, in the order set in the Studio, and the page's
// own words (the Architecture page document, or the page's defaults)
const { sanity } = Astro.locals;
const [projects, page] = await Promise.all([sanity.fetch(PROJECT_INDEX_QUERY), sanity.fetch(ARCHITECTURE_PAGE_QUERY)]);
const D = PAGE_DEFAULTS.architecturePage;
---
<BaseLayout title="Architecture — Tomrowstudios" namespace="architecture" pageName="Architecture" mainClass="arch-page" pageDoc="architecturePage">
<SiteNav />

<!-- One screen, moving sideways, after an editorial index: a single row of
     small 16:9 pictures across the middle of the screen, a great deal
     of room above and below, the page's name over the row under the
     studio's name, and each project's name and context under its picture.
     One picture is in colour at a time, the one nearest the middle or the
     one under the pointer, with its name shown; the rest stand back in
     black and white. The pictures drift a
     little in their frames as the row moves (Osmo's parallax slider,
     archslider.js). The row is reached by dragging, by the arrows, or by
     scrolling up and down, which the slider reads as left and right; a fine
     line along the foot of the screen says how far along it is. -->
<!-- data-lenis-prevent: the page's smooth scrolling leaves the wheel to the
     row here (the page itself never scrolls) -->
<section class="arch-stage" data-lenis-prevent>

  <div data-parallax-init class="parallax-slider__group arch-stage__group">

    <div class="arch-stage__head">
      <!-- The name, and beside it, small and raised, how many projects the
           row shows (the projects from Sanity, counted) -->
      <h1 class="arch-stage__title"><span data-page-field="header.heading">{page?.header?.heading ?? D.header.heading}</span><sup class="arch-stage__count">[{projects.length}]</sup></h1>
      <div class="arch-arrows">
        <button type="button" data-parallax-prev class="arch-arrow is--prev" aria-label="Previous project"><Arrow shape="corner" rotate={225} /></button>
        <button type="button" data-parallax-next class="arch-arrow is--next" aria-label="Next project"><Arrow shape="corner" rotate={45} /></button>
      </div>
    </div>
    <div class="arch-stage__slider">
      <div class="parallax-slider__collection">
        <div data-parallax-slider data-parallax-amount="10" class="parallax-slider__list">

          {projects.map((project) => (
          <div class="parallax-slider__item">
            <a href={`/projects/${project.slug}`} class="parallax-slider__item-link">
              <div class="parallax-slider__item-inner">
                <div data-parallax-inner class="parallax-slider__item-visual">
                  {project.coverImage && <img {...imageAttrs(project.coverImage, 1600)} draggable="false" alt={project.coverImage.alt || project.name || ''} class="parallax-slider__item-img">}
                </div>
              </div>
              <div class="parallax-slider__item-label">
                <p class="parallax-slider__item-name">{project.name}</p>
                <span class="parallax-slider__item-meta">{[project.year, project.context].filter(Boolean).join(' / ')}</span>
              </div>
            </a>
          </div>
          ))}

        </div>
      </div>
      <!-- Under the row, on the name's left edge: the first half of the
           words the home hero sets under this part's name (home-hero.ts) -->
      <p class="arch-stage__about">Tom’s own design work, from early studies to his dissertation.</p>
    </div>

    <!-- How far along the row: a fine line along the foot of the screen,
         edge to edge; pressed, the row goes there -->
    <div data-parallax-progress-wrap class="progress-bar-wrap">
      <div data-parallax-progress class="progress-bar"></div>
    </div>

  </div>

</section>

<ContactPanel />
</BaseLayout>
