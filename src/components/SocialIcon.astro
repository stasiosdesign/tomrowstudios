---
/* The channel and contact glyphs the floating navigation uses (its blocks
   beside the bar and in the menu): simple outlines on a 24-unit grid, one
   pixel of line at any size, in the text colour. Decorative — the link
   around each carries the name. */
interface Props {
  name: 'instagram' | 'youtube' | 'linkedin' | 'x' | 'mail';
  class?: string;
}
const { name, class: className } = Astro.props;
---
<svg class={className} viewBox="0 0 24 24" fill="none" aria-hidden="true" focusable="false">
  {name === 'instagram' && (
    <>
      <rect x="3.5" y="3.5" width="17" height="17" rx="4.5" stroke="currentColor" vector-effect="non-scaling-stroke" />
      <circle cx="12" cy="12" r="3.8" stroke="currentColor" vector-effect="non-scaling-stroke" />
      <circle cx="17" cy="7" r="0.9" fill="currentColor" />
    </>
  )}
  {name === 'youtube' && (
    <>
      <rect x="2.5" y="5.5" width="19" height="13" rx="3.5" stroke="currentColor" vector-effect="non-scaling-stroke" />
      <path d="M10.2 9.2v5.6l4.8-2.8z" fill="currentColor" />
    </>
  )}
  {name === 'linkedin' && (
    <>
      <rect x="3.5" y="3.5" width="17" height="17" rx="2.5" stroke="currentColor" vector-effect="non-scaling-stroke" />
      <path d="M8.2 10.5v6M12 16.5v-3.4a2.1 2.1 0 0 1 4.2 0v3.4M12 10.5v6" stroke="currentColor" vector-effect="non-scaling-stroke" />
      <circle cx="8.2" cy="7.8" r="0.9" fill="currentColor" />
    </>
  )}
  {name === 'x' && (
    <>
      <path d="M4.5 4.5h4l11 15h-4z" stroke="currentColor" stroke-linejoin="round" vector-effect="non-scaling-stroke" />
      <path d="M19.2 4.5 13.4 11M10.6 13l-5.8 6.5" stroke="currentColor" vector-effect="non-scaling-stroke" />
    </>
  )}
  {name === 'mail' && (
    <>
      <rect x="3" y="5.5" width="18" height="13" rx="2" stroke="currentColor" vector-effect="non-scaling-stroke" />
      <path d="m3.6 6.4 8.4 6.6 8.4-6.6" stroke="currentColor" vector-effect="non-scaling-stroke" />
    </>
  )}
</svg>
