---
/* The site's box button, after Contact: two boxes side by side, one link —
   its word, in the links' own face and with their roll on hover
   (split-hover.js, as the column of pages has it), and the arrow in a
   square of the same height. As Contact (the default) it opens the contact
   form out of the floating bar (floatingnav.js): at the top right of every
   page (SiteHead.astro) and in the footer's Contact column
   (SiteFooter.astro). With an `href` it is a plain link, and with
   `secondary` a quieter outline of itself (the Partners page's calls to
   action, partner.astro). style.css, .hero-nav__contact. */
import type { HTMLAttributes } from 'astro/types';
import Arrow from './Arrow.astro';

interface Props extends Omit<HTMLAttributes<'a'>, 'class'> {
  class?: string;
  /** The words; Contact by default */
  label?: string;
  /** A page to go to rather than the contact form */
  href?: string;
  secondary?: boolean;
}
const { class: className, label = 'Contact', href, secondary, ...rest } = Astro.props;
const contact = !href;
const opens = contact ? { 'data-fnav-contact-open': '', 'data-barba-prevent': 'self', 'aria-haspopup': 'dialog' as const, 'aria-controls': 'fnav-contact' } : {};
---
<a href={href ?? '#contact'} class:list={['hero-nav__contact', className, { 'is--secondary': secondary }]} {...opens} data-split-hover="link" {...rest}>
  <span class="hero-nav__contact-label"><span data-split-hover="target">{label}</span></span>
  <span class="hero-nav__contact-square"><Arrow class="hero-nav__contact-arrow" shape="straight" /></span>
</a>
