---
/* A shop item's card, on the Shop page and in the Related row of an item's
   own page: a strip of labels, the picture, the name with its format under
   it, and a ruled foot with the call to action. The whole card is the link. */
import { imageAttrs, type SanityImage } from '../sanity/image';

interface Props {
  item: {
    title?: string | null;
    slug?: string | null;
    card?: {
      image?: SanityImage | null;
      kind?: string | null;
      meta?: string | null;
      button?: string | null;
    } | null;
  };
  /** Its place in the list, from 1: the number in the label strip. */
  index?: number;
}

const { item, index } = Astro.props;
const card = item.card;
const image = card?.image?.asset ? card.image : null;
---
<a class="product-card" href={`/${item.slug}`}>
  <span class="product-card__top">
    {index && <span class="product-card__index">N.{String(index).padStart(2, '0')}</span>}
    {card?.kind && <span class="product-card__tag">{card.kind}</span>}
  </span>
  <span class="product-card__media">
    {image && <img {...imageAttrs(image, 800)} loading="lazy" decoding="async" alt={image.alt ?? ''}>}
  </span>
  <span class="product-card__body">
    <span class="product-card__name">{item.title}</span>
    {card?.meta && <span class="product-card__meta">{card.meta}</span>}
  </span>
  <span class="product-card__foot">
    <span class="product-card__cta">{card?.button ?? 'View'}</span>
    <span class="product-card__arrow" aria-hidden="true"><svg viewBox="0 0 12 12" fill="none"><path d="M4.5 2 8.5 6 4.5 10" stroke="currentColor" stroke-width="1.25"/></svg></span>
  </span>
</a>
