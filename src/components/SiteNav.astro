---
/* The bar at the top of every page but the home page: a black band carrying
   the grid's lines and the hero's navigation (HeroNav.astro: the studio's
   name and mark, the column of pages and the ways to Tom) exactly where the
   home hero has it, so the header is one and the same throughout the site,
   its colours alone following the page (dark over a light page). It
   lives inside the Barba container on every page: the transition swaps it
   with the page. `overHero` starts it transparent over a hero on the
   first paint (the parked home hero alone, /parked, with hero-nav.js). */
import HeroNav from './HeroNav.astro';
interface Props { overHero?: boolean }
const { overHero } = Astro.props;
// The page being built, as the links name it, so its link carries aria-current.
// The build sees /shop.html and /index.html (build.format 'file'); dev sees /shop and /.
const page = Astro.url.pathname.replace(/\.html$/, '').replace(/\/index$/, '') || '/';
---
<!-- Navbar -->
<header class={overHero ? "site-nav is--over-hero" : "site-nav"}>
  <div class="site-nav__inner">
    <HeroNav current={page} />
  </div>
</header>
