---
/* The scrolled-state navigation: a Menu control fixed at the top right once
   the page's hero has gone by, and the stepped menu it opens — five panels
   side by side, each a link, sharing a top edge and stepping down in height
   from Influence to Contact. The staircase is layout: each panel is built at
   its final size and revealed by a clip-path from its top edge down, in a
   short overlapping stagger (stepnav.js). The labels' rolling text is a
   separate layer: two copies of each word in a clipped line, the second
   rolling up into the first's place.

   Lives in the layout, outside the Barba container, so it survives a
   navigation; stepnav.js binds it once and re-ties it to each page's hero.
   The exposed bar (SiteNav.astro) is untouched — this only appears where
   that bar has scrolled away.

   Contact is the site's contact drawer, not a page: the link opens the
   drawer of the current page and falls back to the home page's anchor. */
const items = [
  { href: 'influence.html', label: 'Influence' },
  { href: 'architecture.html', label: 'Architecture' },
  { href: 'shop.html', label: 'Shop' },
  { href: 'partner.html', label: 'Partners' },
  { href: 'index.html#contact', label: 'Contact', contact: true },
];
---
<div data-step-nav data-step-nav-state="hero" data-step-nav-open="false" class="step-nav">
  <button type="button" data-step-nav-toggle class="step-nav__toggle" aria-expanded="false" aria-controls="step-nav-menu" aria-label="Open menu">
    <span class="step-nav__roll">
      <span class="step-nav__roll-text" data-step-nav-toggle-label="menu">Menu</span>
      <span class="step-nav__roll-text is--shadow" data-step-nav-toggle-label="close" aria-hidden="true">Close</span>
    </span>
  </button>
  <nav id="step-nav-menu" data-step-nav-menu class="step-nav__menu" aria-label="Site menu" aria-hidden="true" inert>
    {items.map((item, i) => (
      <a
        href={item.href}
        data-step-nav-link
        data-step-nav-contact={item.contact ? '' : undefined}
        data-barba-prevent={item.contact ? 'self' : undefined}
        class="step-nav__panel"
        style={`--step: ${i};`}
      >
        <span class="step-nav__index" data-step-nav-index>{String(i + 1).padStart(2, '0')}</span>
        <span class="step-nav__label">
          <span class="step-nav__roll">
            <span class="step-nav__roll-text" data-step-nav-text>{item.label}</span>
            <span class="step-nav__roll-text is--shadow" data-step-nav-text-shadow aria-hidden="true">{item.label}</span>
          </span>
        </span>
      </a>
    ))}
  </nav>
</div>
