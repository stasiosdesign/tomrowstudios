---
/* The site's one call to action. Three independent hairlines — top, left and
   bottom, the right side left open — and a content layer holding the label and
   the arrow, kept apart so button.js can move the frame without moving the
   type. Every instance shares this markup; only the label, the link attributes
   and the secondary variant vary. The geometry, colours and grid sizing live in
   the CTA block of style.css. */
interface Props extends astroHTML.JSX.AnchorHTMLAttributes {
  label: string;
  secondary?: boolean;
}

const { label, secondary = false, class: className, ...rest } = Astro.props;
---
<a data-cta {...rest} class:list={["cta", className, { "is--secondary": secondary }]}><span class="cta__line is--top" aria-hidden="true"></span><span class="cta__line is--left" aria-hidden="true"></span><span class="cta__line is--bottom" aria-hidden="true"></span><span class="cta__content"><span data-cta-label class="cta__label">{label}</span><svg class="cta__icon" viewBox="0 0 12 12" fill="none" aria-hidden="true"><path d="M4 1.5 8.5 6 4 10.5" stroke="currentColor" stroke-width="1.25" stroke-linecap="square"/></svg></span></a>
