---
/* The Presentation tool's click-to-edit outlines, rendered only while a page
   is in draft mode (open in the Studio). Loaded from esm.sh, pinned, so the
   overlay code never becomes part of the site's own bundle. After an edit the
   Studio reloads the page, which re-renders with the draft. */
---
<link rel="stylesheet" href="https://esm.sh/@sanity/visual-editing-standalone@2.0.1/styles.css">
<script is:inline type="module">
  import { enableVisualEditing } from 'https://esm.sh/@sanity/visual-editing-standalone@2.0.1';

  const COOKIE = 'sanity-preview-perspective';
  const current = document.cookie.match(new RegExp(`(?:^|; )${COOKIE}=([^;]*)`))?.[1];

  enableVisualEditing({
    // Above the site's own layers (the highest is 400)
    zIndex: 10000,
    // The Studio's Drafts / Published switch: remember it for the server's
    // next render, and reload only if the page was rendered the other way
    onPerspectiveChange: (perspective) => {
      const value = Array.isArray(perspective) ? perspective.join(',') : String(perspective);
      if (value === current || (!current && value === 'drafts')) return;
      document.cookie = `${COOKIE}=${value}; path=/; SameSite=None; Secure; Partitioned`;
      location.reload();
    },
  });
</script>
