---
/* The hero's navigation's column of pages, the same on every page: the
   site's pages in one column at the top of the screen (the home hero's own
   column of links, on the line the hero's fields start from, --hero-col),
   this page marked by a square that is one of the grid's own tiles, at
   --hero-top, as every element of the home hero is (style.css, "The
   hero's navigation"). The studio's mark, its name and Contact are the
   header's fixed parts, held at the top of the screen on every page
   (SiteHead.astro); these scroll away with the page.

   Placed by its container: the home hero's sticky layer (HomeHero.astro,
   where it is on the mosaic) and the bar at the top of every other page
   (SiteNav.astro, where it is on the bar's band, its type dark over a
   light page). */
import { pages } from './site-links';

interface Props {
  /** The page being shown, as the links name it: its link carries aria-current */
  current: string;
}
const { current } = Astro.props;
---
<nav class="hero-nav__links site-nav__links" aria-label="Pages" data-dim-group>
  {pages.map(({ href, label }) => <a href={href} data-split-hover="link" class="site-nav__link" aria-current={href === current ? 'page' : undefined}>{label}</a>)}
</nav>
