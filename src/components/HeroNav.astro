---
/* The hero's navigation, the same on every page: at the top of the screen,
   the studio's mark in the top left corner, on the margin
   (BrandMark.astro, --hero-logo-left); the studio's name on the home hero's
   pictures' left edge (--hero-brand-left); the site's
   pages in one column (the home hero's own column of links, on the line
   the hero's fields start from, --hero-col), this page marked by a square
   that is one of the grid's own tiles; and at the top right, Contact: as
   tall as the ways to Tom that stood there (now in the footer,
   SocialSquares.astro), its word in one box and the site's arrow in a
   square beside it, in the Partners page's paper (black on that page),
   which opens the contact form out of the floating bar as
   every other way to contact Tom does (floatingnav.js). All of it stands
   at --hero-top, as every element of the home hero does (style.css, "The
   hero's navigation").

   Placed by its container: the home hero's sticky layer (index.astro,
   where it is on the mosaic) and the bar at the top of every other page
   (SiteNav.astro, where it is on the bar's band, its type dark over a
   light page). */
import BrandMark from './BrandMark.astro';
import Arrow from './Arrow.astro';
import { pages } from './site-links';

interface Props {
  /** The page being shown, as the links name it: its link carries aria-current */
  current: string;
}
const { current } = Astro.props;
---
<!-- The mark and the name both lead home; the name is the one a keyboard
     or a screen reader meets -->
<a href="/" class="hero-nav__logo" tabindex="-1" aria-hidden="true"><BrandMark class="hero-nav__logo-mark" /></a>
<a href="/" class="hero-nav__brand" aria-label="Tomrowstudios, home"><span aria-hidden="true">tomrowstudios<span class="hero-nav__copy">©</span></span></a>
<nav class="hero-nav__links site-nav__links" aria-label="Pages" data-dim-group>
  {pages.map(({ href, label }) => <a href={href} data-split-hover="link" class="site-nav__link" aria-current={href === current ? 'page' : undefined}>{label}</a>)}
</nav>
<!-- Contact: two boxes side by side, one link — its word, in the links'
     own face and with their roll on hover (split-hover.js, as the column of
     pages has it), and the arrow in a square of the same height -->
<a href="#contact" class="hero-nav__contact" data-fnav-contact-open data-barba-prevent="self" aria-haspopup="dialog" aria-controls="fnav-contact" data-split-hover="link">
  <span class="hero-nav__contact-label"><span data-split-hover="target">Contact</span></span>
  <span class="hero-nav__contact-square"><Arrow class="hero-nav__contact-arrow" shape="straight" /></span>
</a>
