---
/* A statement set as one rectangular block of text across the page, its
   first line opening after an indent. Used on the home page (the practice
   statement) and on Influence (the approach, just after the map). */
interface Props {
  text: string;
  field?: string;
  highlight?: boolean;
  /** The block centred in its section by its lines' own extent, the text
      still set from the left (influence.js, initStatementCentre) */
  centred?: boolean;
}
const { text, field, highlight, centred } = Astro.props;
---
<div class:list={['statement-block', { 'is--centred': centred }]}>
  <h2 class="statement-block__text" data-page-field={field} data-highlight-text={highlight ? '' : undefined}>{text}</h2>
</div>
