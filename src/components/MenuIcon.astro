---
/* The menu's own icons, one for each page (FloatingNav.astro): line
   drawings on a 24 square, each as it was supplied, drawn in the card's ink
   (currentColor) with lines a little under a pixel at any size
   (style.css, .fnav-tile__arrow.is--icon), in the place of the cards'
   arrow at their top right. */
interface Props {
  name: 'partners' | 'influence' | 'shop' | 'architecture';
  class?: string;
}
const { name, class: className } = Astro.props;
// Each drawing's lines: [path, a mitred corner kept sharp]
const ICONS: Record<Props['name'], [string, boolean?][]> = {
  partners: [
    ['M12 11.5C14.2091 11.5 16 9.70914 16 7.5C16 5.29086 14.2091 3.5 12 3.5C9.79086 3.5 8 5.29086 8 7.5C8 9.70914 9.79086 11.5 12 11.5Z'],
    ['M4.5 21V17L7.5 14L12 15.5L16.5 14L19.5 17V21'],
  ],
  influence: [
    ['M12 22C17.5228 22 22 17.5228 22 12C22 6.47715 17.5228 2 12 2C6.47715 2 2 6.47715 2 12C2 17.5228 6.47715 22 12 22Z'],
    ['M12 22C14.2091 22 16 17.5228 16 12C16 6.47715 14.2091 2 12 2C9.79086 2 8 6.47715 8 12C8 17.5228 9.79086 22 12 22Z'],
    ['M2 12H22'],
    ['M20 18C17.4703 16.937 14.743 16.4256 12 16.5C9.25702 16.4256 6.52971 16.937 4 18'],
    ['M4 6C6.52971 7.06302 9.25702 7.57439 12 7.5C14.743 7.57439 17.4703 7.06302 20 6'],
  ],
  shop: [
    ['M3 9L5 19H19L21 9H3Z', true],
    ['M6 9L9 4', true],
    ['M18 9L15 4', true],
  ],
  architecture: [
    ['M7.5 16.5L8 13.5L18.5 3H19.5L21 4.5V5.5L10.5 16L7.5 16.5Z', true],
    ['M16.5 4.5L19.5 7.5', true],
    ['M16.5 15.5V21.5H2.5V7.5H8.5'],
  ],
};
---
<svg class={className} viewBox="0 0 24 24" fill="none" aria-hidden="true" focusable="false">
  {ICONS[name].map(([d, mitred]) => <path d={d} stroke="currentColor" stroke-miterlimit={mitred ? '10' : undefined} />)}
</svg>
