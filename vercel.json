{
  "framework": "astro",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    { "source": "/project-:slug(.*)", "destination": "/projects/:slug", "permanent": true },
    { "source": "/projects", "destination": "/architecture", "permanent": false }
  ]
}
