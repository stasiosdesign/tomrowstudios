# Dependencies, for the site and for studio/
node_modules/

# Build output: the site's dist/, and the Studio's studio/dist/
dist/

# Astro's generated types and caches
.astro/

# Sanity Studio: the dev server's runtime, and TypeGen's schema extract
# (regenerated by `npm run typegen` in studio/; the types it writes,
# src/sanity/sanity.types.ts, are committed)
studio/.sanity/
studio/schema.json

# Original photos, kept on disk only; the site's optimised copies live in
# public/assets/photos/
source-assets/

# Environment files and keys. None are needed today; if one is added,
# commit only .env.example, never real values
.env
.env.*
!.env.example
*.pem

# Local tool state
.vercel/
.claude/settings.local.json
*.tsbuildinfo

# Logs and OS files
*.log
npm-debug.log*
.DS_Store
Thumbs.db
desktop.ini
