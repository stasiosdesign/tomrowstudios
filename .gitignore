# Dependencies, for the site and for studio/
node_modules/

# Build output: the site's dist/, and the Studio's studio/dist/
dist/

# Astro's generated types and caches
.astro/

# Sanity Studio: the dev server's runtime, and TypeGen's schema extract
# (regenerated by `npm run typegen` in studio/; the types it writes,
# src/sanity/sanity.types.ts, are committed)
studio/.sanity/
studio/schema.json

# Original photos, kept on disk only; the site's optimised copies live in
# public/assets/photos/
source-assets/

# Environment files and keys: real values never go in Git. .env.example lists
# the site's variables. The Studio's two committed files hold only public
# settings (every SANITY_STUDIO_ value is compiled into the public Studio);
# overrides for one machine go in the git-ignored .env*.local files.
.env
.env.*
!.env.example
!studio/.env.development
!studio/.env.production
*.pem

# Local tool state, and the Vercel adapter's build output (.vercel/output)
.vercel/
.claude/settings.local.json
*.tsbuildinfo

# Logs and OS files
*.log
npm-debug.log*
.DS_Store
Thumbs.db
desktop.ini
