# The website's environment variables. Never commit real values.
#
# On your machine: copy what you need into .env.development.local (git-ignored),
#   which `npm run dev` reads.
# On Vercel: Project → Settings → Environment Variables, scoped as noted below.
#
# Which deployment a build is for comes from Vercel itself (VERCEL_ENV), not
# from a variable here: see astro.config.mjs.

# The public site's address, for canonical links, Open Graph URLs, the sitemap
# and robots.txt. Vercel: Production AND Preview, the same value, so staging
# names production as the canonical site. Change it when a custom domain
# arrives. If unset on Vercel, the project's production domain is used.
SITE_URL=https://tomrowstudios.vercel.app

# A Sanity API token with the Viewer role, for draft mode (drafts on staging).
# SECRET: server-side only, never give it a PUBLIC_ prefix.
# Vercel: Preview, Git branch `staging` only; never Production.
# Locally: lets `npm run dev` show drafts in the local Studio's Visual editor.
SANITY_API_READ_TOKEN=

# Optional, public: build against another Sanity project or dataset.
# PUBLIC_SANITY_PROJECT_ID=5cwu7mnl
# PUBLIC_SANITY_DATASET=production
